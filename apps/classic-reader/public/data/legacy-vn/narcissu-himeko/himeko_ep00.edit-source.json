ko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-1b6"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「－途中，手里拿着便利店买的便当，\n 姬子突然小声说道－」","speaker":"濑津美"}},{"key":"[\"mjo/patches/narci_himeko/%23mjo/himeko_ep00\",\"main\"]/mjo-29b","target":{"variantId":"mjo/patches/narci_himeko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-29b"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「濑津美，\n 总之让我也定个规矩吧」","speaker":"姬子"}},{"key":"[\"mjo/patches/narci_himeko/%23mjo/himeko_ep00\",\"main\"]/mjo-331","target":{"variantId":"mjo/patches/narci_himeko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-331"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……规矩？」","speaker":"濑津美"}},{"key":"[\"mjo/patches/narci_himeko/%23mjo/himeko_ep00\",\"main\"]/mjo-386","target":{"variantId":"mjo/patches/narci_himeko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-386"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯，交朋友其实也是可以的」","speaker":"姬子"}},{"key":"[\"mjo/patches/narci_himeko/%23mjo/himeko_ep00\",\"main\"]/mjo-42a","target":{"variantId":"mjo/patches/narci_himeko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-42a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"钟声回响着。\n姬子把车停在了教会前，姬子让我下了车。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_himeko/%23mjo/himeko_ep00\",\"main\"]/mjo-4da","target":{"variantId":"mjo/patches/narci_himeko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-4da"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「那，就在这里道别吧」","speaker":"姬子"}},{"key":"[\"mjo/patches/narci_himeko/%23mjo/himeko_ep00\",\"main\"]/mjo-511","target":{"variantId":"mjo/patches/narci_himeko/%23mjo/himeko_ep00","sectionId":"main","eventId":"mjo-511"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"然后…"