\\\"]/mjo-1b8\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-1dc\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-1b8"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…嗯，接下来嘛，老婆婆」","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-1fa\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-228\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-1fa"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯嗯。」","speaker":"老婆婆"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-24a\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-27c\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-24a"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「车站嘛，沿着这条路直走，在第二个信号灯处左拐就可以看到了哟！」","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-2b2\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-2ea\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-2b2"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……什么？在第二个信号灯处淫乱生脏？」","speaker":"老婆婆"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-320\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-35e\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-320"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「唔……到前半部分为止还算对得上，但是后面您听错了好多呢」","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-382\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-3cc\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-382"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「啊啦啊啦，原来不是生肝，是满口假牙吗。」","speaker":"老婆婆"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-3f2\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-444\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-3f2"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「真是的，不对啦！。除了『生肝』以外的内容都和之前对不上号呢","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-456\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-4b7\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-456"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「不好意思呢，这阵子我耳背得厉害…」","speaker":"老婆婆"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-4c0\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-52b\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-4c0"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「没有关系……」","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-4e7\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-55c\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-4e7"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"就这样，我并没有被这位耳背得离奇的老婆婆所雷到，继续微笑着对着她解释着。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-546\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-5d3\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-546"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…但是，心底还是在想『居然听错成生肝，还真是错的离谱啊……』","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-5c8\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-665\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-5c8"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯……啊，那么，老婆婆，我再跟您说明一下吧！」","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-620\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-6d8\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-620"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「这样啊，我把相片放在卷首…」","speaker":"老婆婆"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-684\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-74e\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-684"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「我好像没有那么说过吧……」","speaker":"千里"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-6b7\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-791\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard00","sectionId":"main","eventId":"mjo-6b7"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"又是意想不到的回答\n……这已经不是什么耳背的级别了","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard00\\\",\\\"main\\\"]/mjo-70f\",\"[\\\