c.unpacked/nard14\\\",\\\"main\\\"]/mjo-20a\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-277\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-20a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……明明不是那样的。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-232\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-2a2\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-232"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"明明决定了要那样做，明明的确那样做了。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-26c\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-2e3\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-26c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"——黑暗，寒冷的房间里。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-298\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-314\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-298"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我一个人胡思乱想着。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-2c0\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-351\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-2c0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"想着到今天为止的事，今天的事，明天的事，还有明天以后的事……实际上想了非常多。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-322\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-3c0\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-322"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不过……","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-33e\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-3dd\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-33e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"果然，想得最多的是今天的事。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-36e\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-424\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-36e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"嘛，那也是当然的吧。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-396\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-467\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-396"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……那是痛苦的决断。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-3be\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-492\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-3be"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"然后真正痛苦的是，说的人和听的人……都是那么痛苦。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-404\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-504\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-404"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不过这样就好了……一定。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-430\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-537\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-430"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那样做也是为了那个人。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-45a\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-574\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-45a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我那样劝说自己，这是正确的，我告诉自己做了正确的判断。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-4a4\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-5db\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-4a4"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"——明天。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-4c2\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-5fc\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-4c2"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我就要去７楼了。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-4e6\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-627\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-4e6"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那在某种意义上，和走向比卷云所漂浮的天空还要高的地方是一样的。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-538\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-691\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-538"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"对我来说那是那非常讽刺，是个恶劣的笑话。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-574\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-703\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-574"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……我不能够按照正规的做法，一个一个地抵消到卷云的高度。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-5c0\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-77f\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-5c0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那样的我却，要到比卷云还高的地方去……","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-5fa\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-7be\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-5fa"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"明天，还没有到达到卷云的高度的我，就要去７楼了——","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-640\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-81b\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-640"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那是远离地上的生活７０００米以上的地方。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-67c\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-885\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-67c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我将要去那里，去那高空７０００米以上的接近死亡的地方。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-6c6\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-8f1\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-6c6"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"——明天，那是我上去７楼的日子。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-6fa\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-93a\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-6fa"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"还有，是我不得不和哥哥诀别的日子。","speaker":"旁白"}},{"key":"[\"[\\\"mjo/narcissu3/update.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-730\",\"[\\\"mjo/narcissu3/scenario.arc.unpacked/nard14\\\",\\\"main\\\"]/mjo-983\"]","target":{"variantId":"mjo/narcissu3/update.arc.unpacked/nard14","sectionId":"main","eventId":"mjo-730"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那么悲伤的日子，那么悲伤的时刻，已经马上就要来临了——","speaker":"旁白"}}]}
