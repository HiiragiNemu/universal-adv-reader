      "sectionId": "main",
      "entryEventId": "ikura-13",
      "events": [
        {
          "eventId": "ikura-13",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 2,
            "opcode": 247,
            "status": "translated",
            "zhOffset": 19,
            "jaOffset": 19,
            "originalDisplayText": {
              "zh-CN": "追忆",
              "ja-JP": "おもいで"
            }
          },
          "nextEventId": "ikura-3e",
          "textLineIndex": {
            "ja-JP": 0
          }
        },
        {
          "eventId": "ikura-3e",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 8,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 58,
            "jaOffset": 62,
            "originalDisplayText": {
              "zh-CN": "加　奈：『哥哥！』",
              "ja-JP": "加　奈：『お兄ちゃん！』"
            }
          },
          "nextEventId": "ikura-8c",
          "textLineIndex": {
            "ja-JP": 1
          },
          "cues": [
            {
              "cueId": "cue-b17940cc53066b40",
              "kind": "voice",
              "timing": "utterance",
              "mediaId": "asset/a-ea04212edec33bf7",
              "resolverId": "research-media-v1",
              "raw": {
                "sourceKey": "Kan5450",
                "playbackPath": "raw/kana/VOICE.unpacked/KAN5450.OGG",
                "instructionIndex": 8
              }
            }
          ]
        },
        {
          "eventId": "ikura-8c",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 16,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 136,
            "jaOffset": 140,
            "originalDisplayText": {
              "zh-CN": "　仿佛从背后被叫住一般，不知为何有这种飘渺的感觉。",
              "ja-JP": "　背後から呼びとめられそうな、そんな雰囲気が漂う。"
            }
          },
          "nextEventId": "ikura-df",
          "textLineIndex": {
            "ja-JP": 2
          }
        },
        {
          "eventId": "ikura-df",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 24,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 237,
            "jaOffset": 223,
            "originalDisplayText": {
              "zh-CN": "　虽然这是让人很悲伤的事故，但我相信加奈是全力以赴地过完了她的人生的。",
              "ja-JP": "　それは、とても悲しい出来事だったけど、俺は加奈の人生が精一杯のものだということを今は信じている。"
            }
          },
          "nextEventId": "ikura-136",
          "textLineIndex": {
            "ja-JP": 3
          }
        },
        {
          "eventId": "ikura-136",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 27,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 331,
            "jaOffset": 310,
            "originalDisplayText": {
              "zh-CN": "　即使同样是悲哀的回忆，虽然有些令人撕心裂肺，有的却不尽然，最近的我发现了这点。",
              "ja-JP": "　同じ悲しい思い出でも、胸が引き裂かれそうなものと、そうでないものがあることを最近知った。"
            }
          },
          "nextEventId": "ikura-1a0",
          "textLineIndex": {
            "ja-JP": 4
          }
        },
        {
          "eventId": "ikura-1a0",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 35,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 462,
            "jaOffset": 416,
            "originalDisplayText": {
              "zh-CN": "　一边仔细的斟酌着计划，一边在校园内散步着。",
              "ja-JP": "　つらつらと計画を練りながら、キャンパスを歩いていく。"
            }
          },
          "nextEventId": "ikura-1f5",
          "textLineIndex": {
            "ja-JP": 5
          }
        },
        {
          "eventId": "ikura-1f5",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 43,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 557,
            "jaOffset": 501,
            "originalDisplayText": {
              "zh-CN": "　秋天的天空显得有点晃眼。",
              "ja-JP": "　秋空がまぶしい。"
            }
          },
          "nextEventId": "ikura-218",
          "textLineIndex": {
            "ja-JP": 6
          }
        },
        {
          "eventId": "ikura-218",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 46,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 607,
            "jaOffset": 536,
            "originalDisplayText": {
              "zh-CN": "　拭去眼边浮着的水汽。",
              "ja-JP": "　目の端に浮いた水っ気を払う。"
            }
          },
          "nextEventId": "ikura-260",
          "textLineIndex": {
            "ja-JP": 7
          }
        },
        {
          "eventId": "ikura-260",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 54,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 680,
            "jaOffset": 608,
            "originalDisplayText": {
              "zh-CN": "　冬天，还没有到呢，我想到。",
              "ja-JP": "　また、冬がやって来るな、と思った。"
            }
          },
          "nextEventId": "ikura-2a8",
          "textLineIndex": {
            "ja-JP": 8
          }
        },
        {
          "eventId": "ikura-2a8",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 62,
            "opcode": 43,
            "status": "translated",
            "zhOffset": 759,
            "jaOffset": 680,
            "originalDisplayText": {
              "zh-CN": "　到了周年忌的话，一定又能看到白雪飘落吧。",
              "ja-JP": "　一周忌にはきっと、思わず目をみはるような白い雪が降るだろう。"
            }
          },
          "nextEventId": "ikura-306",
          "textLineIndex": {
            "ja-JP": 9
          }
        },
        {
          "eventId": "ikura-306",
          "kind": "line",
          "source": {
            "engine": "ikura",
            "instructionIndex": 72,
            "opcode": 43,
            "status": "unchanged",
