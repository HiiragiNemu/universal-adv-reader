okaeri/ev36/zh-ja\",\"main\"]/ikura-2894","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2894"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"我的判断，大概是对的吧。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2919","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2919"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「咦，隆道。你认识那家伙么」","speaker":"育郎"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2958","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2958"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「是育郎啊」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2983","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2983"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"从小学开始的朋友——船津育郎站在我身后。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-29db","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-29db"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「育郎，你知道那家伙的事情么？」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2a0f","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2a0f"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「算是吧。三乡中学田径部的选手哦。在县大会由于刷新了县记录，所以各处的学校都曾经邀请过他入学呢」","speaker":"育郎"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2a84","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2a84"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「诶～」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2aa7","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2aa7"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「但是不可思议的是，他拒绝了所有的名校的邀请，进入了这所当地的学校……这可是相当有名的事情哦」","speaker":"育郎"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2b1f","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2b1f"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"我完全不知道。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2b40","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2b40"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"如果那家伙是为了和加奈一起而选择了当地的学校的话……","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2b9f","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2b9f"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「果然，是个可怕的家伙」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2bcb","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2bcb"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「哈，说什么呢？」","speaker":"育郎"}},{"key":"[\"paired/kana-okaeri/ev36/zh-ja\",\"main\"]/ikura-2bfd","target":{"variantId":"paired/kana-okaeri/ev36/zh-ja","sectionId":"main","eventId":"ikura-2bfd"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「哦，别放在心上」","speaker":"隆道"}}]}
