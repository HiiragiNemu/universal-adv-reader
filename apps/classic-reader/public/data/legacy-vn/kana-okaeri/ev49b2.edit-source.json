b2/zh-ja\",\"main\"]/ikura-2ab","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-2ab"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「小心别被风吹到着凉啊。」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-2dc","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-2dc"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……（点头）」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-329","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-329"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"那知性的双瞳，似乎要将这碧蓝无垠的海面烙如其中一般久久地凝视着。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-36a","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-36a"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"已经……看了差不多快要有三十分钟了。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-39a","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-39a"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"我不禁感慨她还真是不会感到腻。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-3c9","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-3c9"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"之后，又觉得自己这样想真是太羞耻了。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-416","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-416"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"加奈她是第一次看到大海。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-45b","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-45b"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"那份初次的感动长久地萦绕在心头挥之不去，才会如此地伫立吧。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-4ff","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-4ff"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……海。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-52f","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-52f"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「啊啊。」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-552","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-552"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「是海啊。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-5a0","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-5a0"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"加奈“沙沙”地迈开脚步，来到浪花边上。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-5da","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-5da"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"弯下腰伸出双手，捧起一把湿润的沙子。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-62f","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-62f"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"软泥般的沙子就仿佛受着浪花的冲击一般，慢慢地从指缝间流下。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-68f","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-68f"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「好凉。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-6d8","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-6d8"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"说完，加奈天真烂漫地笑了起来。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-71f","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-71f"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「要是夏天的话就能游泳了啊。」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-74d","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-74d"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……没关系……反正我也不会游泳。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-78d","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-78d"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「是嘛……」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-7b5","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-7b5"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「只是这样看着就已经很快乐了。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-807","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-807"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"说完，加奈将视线投向了远方的水平线。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-858","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-858"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「看起来是不是有些圆？」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-886","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-886"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「这么一说……好像确实有这种感觉。不过哥哥不提的话可能就会察觉不到了。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-8dd","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-8dd"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「要是有帆船什么的出现的话就会明白了。」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-927","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-927"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"似乎是察觉到了我小小的玩笑，加奈扑哧地笑了。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-969","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-969"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"两人就这样看着大海。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-995","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-995"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"不断地受到浪花拍打的沙滩上，一只小螃蟹七扭八歪地行进着。加奈微笑着看着这一幕。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-9f0","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-9f0"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"伸出手指去捅捅，小螃蟹就马上慌慌张张地钻进沙子里去了。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-a2c","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-a2c"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"加奈不停地小声笑着。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-a6f","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-a6f"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"想起了以前加奈还是中学生时，我经常带着她到处游玩的事。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-ab6","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-ab6"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"那也是个夏天吧。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-adc","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-adc"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"之后自己升了学，行动范围也大了起来，于是就想让加奈也看看外面的广阔世界。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-b7a","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-b7a"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「已经……不能再奔跑了。」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-bd5","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-bd5"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"忽然加奈低语了一句。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-c19","target":{"variantId":"paired/kana-okaeri/ev49b2/zh-ja","sectionId":"main","eventId":"ikura-c19"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「哎？」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev49b2/zh-ja\",\"main\"]/ikura-c3c","target"