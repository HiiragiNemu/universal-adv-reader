d/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-5f3","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-5f3"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「这个，我读了。」","speaker":"夕美"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-640","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-640"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"夕美摆在我面前的是一本叫做《凝视生命》的书。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-69b","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-69b"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"这本书……是我整理了加奈的日记之后改编而成的。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-6de","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-6de"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"有了移植协调员的織笠小姐的推荐，又得到了叔父和香奈的同意，这本书就发刊了，目的是为了促进内脏移植事业的进行。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-74e","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-74e"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"书是由一个小出版社发行的。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-79a","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-79a"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"最初只有一部分人知道，但是通过日常对话和网络开始逐渐流传开来，现在已经是第五次增印了。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-80a","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-80a"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"虽然已经发行了五版，按理是该得到不少的增印费了，但是我把这些钱都捐给了医疗机构，所以实际上没得到什么钱。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-86f","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-86f"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"也并不是想摆出正人君子的样子，只是单纯的不想把加奈的东西拿来当做生存的道具。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-8d7","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-8d7"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「有关我的事也……有稍微被提到了呢。」","speaker":"夕美"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-915","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-915"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-93a","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-93a"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「发生了不少事呢……隆道」","speaker":"夕美"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-999","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-999"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"夕美像这样直接叫我的名字还是第一次。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-9ed","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-9ed"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……大学那边怎么样了？」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ed6/zh-ja\",\"main\"]/ikura-a18","target":{"variantId":"paired/kana-okaeri/ed6/zh-ja","sectionId":"main","eventId":"ikura-a18"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「我有好好地在上啦。因为我想成为护士。」","speaker":"夕美"}},{"key":"[\"pa