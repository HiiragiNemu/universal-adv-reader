                }
              ]
            },
            {
              "eventId": "ikura-674",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 169,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1831,
                "jaOffset": 1652,
                "originalDisplayText": {
                  "zh-CN": "　盆栽上的花蕾，在白雪化掉同时，绽放出了一朵白色的小花。",
                  "ja-JP": "　　　　鉢植えの蕾は、雪解けと同時に、　　　　白い小さな花を咲かせた―――"
                }
              },
              "nextEventId": "ikura-6e1",
              "textLineIndex": {
                "ja-JP": 20,
                "zh-CN": 20
              }
            },
            {
              "eventId": "ikura-6e1",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 179,
                "opcode": 43,
                "status": "unchanged",
                "zhOffset": 1942,
                "jaOffset": 1761,
                "originalDisplayText": {
                  "zh-CN": "",
