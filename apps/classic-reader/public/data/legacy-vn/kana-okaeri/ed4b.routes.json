      },
      "sections": [
        {
          "sectionId": "main",
          "entryEventId": "ikura-63",
          "events": [
            {
              "eventId": "ikura-63",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 15,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 99,
                "jaOffset": 99,
                "originalDisplayText": {
                  "zh-CN": "　三天后。",
                  "ja-JP": "　三日後。"
                }
              },
              "nextEventId": "ikura-ce",
              "textLineIndex": {
                "ja-JP": 0,
                "zh-CN": 0
              },
              "cues": [
                {
                  "cueId": "cue-596d6be552db69f6",
                  "kind": "image",
                  "timing": "scene",
                  "mediaId": "asset/a-dc9cf3ab554a56ab",
                  "resolverId": "research-media-v1",
                  "raw": {
                    "sourceKey": "BLACK",
                    "playbackPath": "derived/images/kana/GGD.unpacked/BLACK.png",
                    "instructionIndex": 4,
                    "targetInstructionIndex": 360
                  }
                }
              ]
            },
            {
              "eventId": "ikura-ce",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 31,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 208,
                "jaOffset": 206,
                "originalDisplayText": {
                  "zh-CN": "　拿着最后一件行李ぞぞ盆栽，我离开了病房。",
                  "ja-JP": "　最後の荷物である鉢植えを持って、俺は病室を後にした。"
                }
              },
              "nextEventId": "ikura-127",
              "textLineIndex": {
                "ja-JP": 1,
                "zh-CN": 1
              },
              "cues": [
                {
                  "cueId": "cue-2b5833758049785b",
                  "kind": "bgm",
                  "timing": "scene",
                  "mediaId": "asset/a-032262e0e39c3df9",
                  "resolverId": "research-media-v1",
                  "raw": {
                    "sourceKey": "TK10.ogg",
                    "playbackPath": "raw/kana/WMSC.unpacked/TK10.OGG",
                    "instructionIndex": 18,
                    "targetInstructionIndex": 2737
                  }
                },
                {
                  "cueId": "cue-b8d67271488ea90f",
                  "kind": "image",
                  "timing": "scene",
                  "mediaId": "asset/a-f204fa801ebf31e2",
                  "resolverId": "research-media-v1",
                  "raw": {
                    "sourceKey": "KBG01A",
                    "playbackPath": "derived/images/kana/GGD.unpacked/KBG01A.png",
                    "instructionIndex": 20,
                    "targetInstructionIndex": 378
                  }
                }
              ]
            },
            {
              "eventId": "ikura-127",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 39,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 299,
                "jaOffset": 295,
                "originalDisplayText": {
                  "zh-CN": "　应该不会再来这里了吧。",
                  "ja-JP": "　もう、ここに来ることもないのだ。"
                }
              },
              "nextEventId": "ikura-151",
              "textLineIndex": {
                "ja-JP": 2,
                "zh-CN": 2
              }
            },
            {
              "eventId": "ikura-151",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 42,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 347,
                "jaOffset": 337,
                "originalDisplayText": {
                  "zh-CN": "　想到这里，不禁深深的感慨了一下。",
                  "ja-JP": "　そう考えると、感慨深いものがある。"
                }
              },
              "nextEventId": "ikura-19a",
              "textLineIndex": {
                "ja-JP": 3,
                "zh-CN": 3
              }
            },
            {
              "eventId": "ikura-19a",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 50,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 432,
                "jaOffset": 410,
                "originalDisplayText": {
                  "zh-CN": "隆　道：「还有……什么东西忘拿吗……」",
                  "ja-JP": "隆　道：「あと……忘れ物はと……」"
                }
              },
              "nextEventId": "ikura-1e7",
              "textLineIndex": {
                "ja-JP": 4,
                "zh-CN": 4
              }
            },
            {
              "eventId": "ikura-1e7",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 58,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 521,
                "jaOffset": 487,
                "originalDisplayText": {
                  "zh-CN": "　环顾室内。",
                  "ja-JP": "　室内を見渡す。"
                }
              },
              "nextEventId": "ikura-226",
              "textLineIndex": {
                "ja-JP": 5,
                "zh-CN": 5
              }
            },
            {
              "eventId": "ikura-226",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 66,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 584,
                "jaOffset": 550,
                "originalDisplayText": {
                  "zh-CN": "　纯白的病房，空空旷旷的，显得很宽阔。",
                  "ja-JP": "　白い病室が、がらんとしていて、とても広く見えた。"
                }
              },
              "nextEventId": "ikura-277",
              "textLineIndex": {
                "ja-JP": 6,
                "zh-CN": 6
              }
            },
            {
              "eventId": "ikura-277",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 74,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 673,
                "jaOffset": 631,
                "originalDisplayText": {
                  "zh-CN": "　曾经的加奈，就这样处在我的视野中心。",
                  "ja-JP": "　この視野の中心には、いつも加奈がいた。"
                }
              },
              "nextEventId": "ikura-2a9",
              "textLineIndex": {
                "ja-JP": 7,
                "zh-CN": 7
              }
            },
            {
              "eventId": "ikura-2a9",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 77,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 735,
                "jaOffset": 681,
                "originalDisplayText": {
                  "zh-CN": "　是因为现在不在这里了么，我总是觉得屋子里少了什么似的。",
                  "ja-JP": "　それがなくなってしまったためか、穴があいたような雰囲気を受ける。"
                }
              },
              "nextEventId": "ikura-302",
              "textLineIndex": {
                "ja-JP": 8,
                "zh-CN": 8
              }
            },
            {
              "eventId": "ikura-302",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 85,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 842,
                "jaOffset": 770,
                "originalDisplayText": {
                  "zh-CN": "　而我的心里，也暂时会这样空洞洞的吧。",
                  "ja-JP": "　俺の心にも、しばらく穴はあいているだろう。"
                }
              },
              "nextEventId": "ikura-333",
              "textLineIndex": {
                "ja-JP": 9,
                "zh-CN": 9
              }
            },
            {
              "eventId": "ikura-333",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 88,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 904,
                "jaOffset": 819,
                "originalDisplayText": {
                  "zh-CN": "　这也是没办法的事。",
                  "ja-JP": "　それは、仕方のないことだった。"
                }
              },
              "nextEventId": "ikura-35d",
              "textLineIndex": {
                "ja-JP": 10,
                "zh-CN": 10
              }
            },
            {
              "eventId": "ikura-35d",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 91,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 948,
                "jaOffset": 861,
                "originalDisplayText": {
                  "zh-CN": "　因为那就像是失去了自己身上的一部分一样。",
                  "ja-JP": "　自分の一部にも等しい存在を失ったのだ。"
                }
              },
              "nextEventId": "ikura-3ac",
              "textLineIndex": {
                "ja-JP": 11,
                "zh-CN": 11
              }
            },
            {
              "eventId": "ikura-3ac",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 99,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1041,
                "jaOffset": 940,
                "originalDisplayText": {
                  "zh-CN": "　唯一可以庆幸的是这里并没有留下任何的绝望和后悔。",
                  "ja-JP": "　ただ、そこに絶望や後悔が微塵もないのが救いだった。"
                }
              },
              "nextEventId": "ikura-400",
              "textLineIndex": {
                "ja-JP": 12,
                "zh-CN": 12
              }
            },
            {
              "eventId": "ikura-400",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 107,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1142,
                "jaOffset": 1024,
                "originalDisplayText": {
                  "zh-CN": "　一直到最后，加奈都直面着自己的命运而活着。",
                  "ja-JP": "　最後まで、加奈は自分の運命と向かい合って生きた。"
                }
              },
              "nextEventId": "ikura-43c",
              "textLineIndex": {
                "ja-JP": 13,
                "zh-CN": 13
              }
            },
            {
              "eventId": "ikura-43c",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 110,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1210,
                "jaOffset": 1084,
                "originalDisplayText": {
                  "zh-CN": "　活着的人即使一味的叹息也无法向死去的人交代。",
                  "ja-JP": "　残される者が、去った者より嘆いていては申し訳も立たない。"
                }
              },
              "nextEventId": "ikura-494",
              "textLineIndex": {
                "ja-JP": 14,
                "zh-CN": 14
              }
            },
            {
              "eventId": "ikura-494",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 118,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1307,
                "jaOffset": 1172,
                "originalDisplayText": {
                  "zh-CN": "　也许再过一周，这里就能从悲伤的气氛中解放出来了吧。",
                  "ja-JP": "　もう一週間もすれば、ここも悲しみの湿気から解放されるだろう。"
                }
              },
              "nextEventId": "ikura-4d3",
              "textLineIndex": {
                "ja-JP": 15,
                "zh-CN": 15
              }
            },
            {
              "eventId": "ikura-4d3",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 121,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1383,
                "jaOffset": 1235,
                "originalDisplayText": {
                  "zh-CN": "　要变回原来那样明朗的感觉还需要很多时间，但是现在的话，这样就足够了。",
                  "ja-JP": "　今までの明るさを取り戻すには、さらに年月が必要だろうが、今はそれで十分だ。"
                }
              },
              "nextEventId": "ikura-537",
              "textLineIndex": {
                "ja-JP": 16,
                "zh-CN": 16
              }
            },
            {
              "eventId": "ikura-537",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 129,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1504,
                "jaOffset": 1335,
                "originalDisplayText": {
                  "zh-CN": "　好了，拿好盆栽回家吧。",
                  "ja-JP": "　さあ、鉢植えを持って、家に帰ろう。"
                }
              },
              "nextEventId": "ikura-5ad",
              "textLineIndex": {
                "ja-JP": 17,
                "zh-CN": 17
              }
            },
            {
              "eventId": "ikura-5ad",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 144,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1623,
                "jaOffset": 1453,
                "originalDisplayText": {
                  "zh-CN": "　就这样。",
                  "ja-JP": "　こうして。"
                }
              },
              "nextEventId": "ikura-5cb",
              "textLineIndex": {
                "ja-JP": 18,
                "zh-CN": 18
              },
              "cues": [
                {
                  "cueId": "cue-3cd1c5419aa7fae8",
                  "kind": "image",
                  "timing": "scene",
                  "mediaId": "asset/a-aa1d8f005a30b7b6",
                  "resolverId": "research-media-v1",
                  "raw": {
                    "sourceKey": "KBG06AP1",
                    "playbackPath": "derived/images/kana/GGD.unpacked/KBG06AP1.png",
                    "instructionIndex": 133,
                    "targetInstructionIndex": 414
                  }
                }
              ]
            },
            {
              "eventId": "ikura-5cb",
              "kind": "line",
              "source": {
                "engine": "ikura",
                "instructionIndex": 147,
                "opcode": 43,
                "status": "translated",
                "zhOffset": 1657,
                "jaOffset": 1483,
                "originalDisplayText": {
                  "zh-CN": "　我走出了多年来不断进出的医院大门。",
                  "ja-JP": "　俺は長年通いつづけた病院の門を出た。"
                }
              },
              "nextEventId": "ikura-663",
              "textLineIndex": {
                "ja-JP": 19,
                "zh-CN": 19
              }
            },
            {
              "eventId": "ikura-663",
              "kind": "line",
              "source": {
                "engine": "ikura",
