d/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1b08","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1b08"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"提到加奈的话，脑海里首先浮现出来的是，支起半身坐在床上，一个人静静的沉醉于书本中的样子。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1b63","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1b63"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"常常是一幅低着头的样子，很少说话，动作也很微小。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1b9f","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1b9f"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"因为没有经常到外面去的缘故，她的皮肤白白的，而且因为不能运动，仅仅是爬个楼梯就会累的喘不过气来。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1c08","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1c08"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"在这之前那种像是枯萎枝叶一般柔弱的身体……总而言之，这一年以来总算是朝着女性应有的丰满成长了起来。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1c72","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1c72"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"身体的成长是健康和食欲的证明，这是一个非常好的迹象。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1cb6","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1cb6"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"要是顺便心理上也能成长得坚强一些的话，那样就更好了……。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1cfd","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1cfd"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"不过从这开始，一切都会朝着好的方向发展……我有这样的预感。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1d3f","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1d3f"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"从孩提时代开始就一直遭受不幸的加奈，总算是开始转运了。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1da0","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1da0"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"藤堂加奈―――","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1dc7","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1dc7"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"我的妹妹。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1e01","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1e01"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"像这样一抱紧她，便能闻到光滑润顺的黑发逸散出来加奈的淡香。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1e45","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1e45"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"这忽然唤起了我多年前昔日的记忆。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1e76","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1e76"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"是的，那是我现在都还记得的少年时代。无论经过多少岁月的洗礼都不会褪色的，无数回忆中的一个。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev11/zh-ja\",\"main\"]/ikura-1ece","target":{"variantId":"paired/kana-okaeri/ev11/zh-ja","sectionId":"main","eventId":"ikura-1ece"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"那是我还没有能……　理解妹妹心中的痛苦的时候―――","speaker":"旁白"}}]}
