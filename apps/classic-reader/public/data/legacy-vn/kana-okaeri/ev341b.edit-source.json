ri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-7c0"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「死亡，很痛苦吗？」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-812","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-812"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"杯子从手里滑落了。白色的牛奶洒满了厨房的水池。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-851","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-851"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"我整整用了三秒，才恢复了平静。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-8a3","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-8a3"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……啊～啊，打碎了呢，这可是喝了好几瓶可乐才换到手的啊」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-8ed","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-8ed"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「……」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-91b","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-91b"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「话说，为什么会想起问这个？」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-952","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-952"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"一边收拾碎片一边问道。心中仿佛打鼓一般。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-992","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-992"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「无意间问问」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-9dc","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-9dc"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"加奈的声音里也没有什么深意。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-a0a","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-a0a"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"我舒了口气。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-a30","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-a30"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"自己被欺负了，或是自己的病什么的，看来并不是为这些事而烦恼。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-a9c","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-a9c"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「谁知道呢，反正我也没死过，不过，肯定早晚会死的」","speaker":"隆道"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-b22","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-b22"},"allowed":["text","speaker"],"speakerReason":"embedded-in-text","baseline":{"text":"「哎，不要这样说啊」","speaker":"加奈"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-b56","target":{"variantId":"paired/kana-okaeri/ev341b/zh-ja","sectionId":"main","eventId":"ikura-b56"},"allowed":["text","speaker"],"speakerReason":"no-native-speaker","baseline":{"text":"加奈慌乱的声音让我吃了一惊，回头一看，加奈的表情说明她打从心底吓了一跳。","speaker":"旁白"}},{"key":"[\"paired/kana-okaeri/ev341b/zh-ja\",\"main\"]/ikura-bbb","target":{"variantId":"paired/kana-okaeri/ev341b/z