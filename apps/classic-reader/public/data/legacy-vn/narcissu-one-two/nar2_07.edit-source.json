/derived/scripts/patch-archives/narci_onetwo/update.arc.unpacked/nar2_07.strings.json","sha256":"2b9aea276176d8bb0bbb4e407af1530bb9ac70f875c2d7e767ebd64731c7d9d6"},{"path":"archive/derived/scripts/patches/narci_onetwo/#mjo/nar2_07.plain.mjo","sha256":"8c0bd54cbbcd6ae4fd788955b1d432e77a8ece5a0dcd7f93ee17fdfca7c358d8"},{"path":"archive/derived/scripts/patches/narci_onetwo/#mjo/nar2_07.script.json","sha256":"55f529eea44bd31f3b9b77da004a5465112c1778ff132a1e3b5abf6f4a7c4f58"},{"path":"archive/derived/scripts/patches/narci_onetwo/#mjo/nar2_07.strings.json","sha256":"4d8d1ad1b9a8974b0eb04abbe07d1a9b162b28954cdeb983de83707e30f6573e"},{"path":"archive/raw/narcissu10-original-ja-JP/narci_onetwo/scenario.arc.unpacked/nar2_07.mjo","sha256":"d144bf210627b2acfe2293644aca4a8babe46f9abe70f34f12c10afaf57a3a45"},{"path":"archive/raw/narcissu10-original/narci_onetwo/scenario.arc.unpacked/nar2_07.mjo","sha256":"07dff283661838a7af0dd8716032b8e58a695ddc05c183b45e6955ba7f894d8e"},{"path":"archive/raw/patch-archives/narci_onetwo/update.arc.unpacked/nar2_07.mjo","sha256":"670d5b6193f9ed8fe92a3089c7be6a1539c8aa15eadde1ca105838747f0cd6d5"},{"path":"archive/raw/patches/narci_onetwo/#mjo/nar2_07.mjo","sha256":"d144bf210627b2acfe2293644aca4a8babe46f9abe70f34f12c10afaf57a3a45"}],"rows":[{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/header","target":null,"allowed":[],"speakerReason":"structural-row","baseline":{"text":"--- Start: nar2_07.txt Section 1 ---","speaker":""}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-c8","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-c8"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"翌日。\n今天我们在不一样的地方吃着午餐。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-15b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-15b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"冷清的谈话室。\n边看着电视里播的无聊的午间新闻边吃着午餐。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-1f3","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-1f3"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯~，这个可乐饼果然很好吃呢」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-236","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-236"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"今天，姬子也似乎还是很想要我的便当里的配菜。\n我能理解，毕竟医院的午餐确实不怎么好吃。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-2c0","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-2c0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"所以，我把放在桌子上的便当，\n和姬子的医院指定用餐放在一起，二个人一起吃。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-36c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-36c"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「那个，这次我想要蔬菜馅的可乐饼」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-3d9","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-3d9"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…右边那个」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-428","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-428"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「好~，谢谢濑津美博士」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-48b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-48b"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「………………」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-4de","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-4de"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…再也不告诉你了」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-537","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-537"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「啊，开玩笑的啦，开玩笑」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-568","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-568"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这么对话着，正要结束今天的用餐之时。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-5e1","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-5e1"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「那个，从之前我就有些在意…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-64a","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-64a"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…难不成你不喜欢吗？」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-67b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-67b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"姬子一边说着，指了指放在便当里的土豆。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-6ea","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-6ea"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「结果，昨天也是我一个人把土豆全部吃完的不是吗？」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-759","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-759"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「………………」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-7ac","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-7ac"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯……讨厌…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-7ff","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-7ff"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「那么，为什么会放进来？」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-862","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-862"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「………………」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-889","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-889"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我不知该如何回答，稍微烦恼一下后…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-8c2","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-8c2"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"还是老老实实的说出来了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-923","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-923"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「以为我是喜欢的…妈妈她…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-98a","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-98a"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「唉~，你也挺辛苦的呢~」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-9c1","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-9c1"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"恐怕，光是这样就能她就能明白这是什么意思了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-a06","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-a06"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"以前的校服也是一样，不知道为什么姬子她，\n好像总是能看穿我想的事情。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-a86","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-a86"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不过，姬子说出的下一句话，\n和之前开朗的语调不同。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-b1c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-b1c"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「不过…这可不是温柔喔」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-b81","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-b81"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「唉？」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-bce","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-bce"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「现在的你大概还不能够理解的吧…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-c3c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-c3c"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「如果你觉得这是在为对方着想的话，可是大错特错呢」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-ca1","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-ca1"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…错的？　不是温柔？","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-cd0","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-cd0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"至少，我知道这句话所说的不是妈妈，\n而是在说我。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-d46","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-d46"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"是正确 还是不正确。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-d71","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-d71"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这样说我能听得懂的。\n就算是我，也不认为隐瞒着不说是正确的。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-de1","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-de1"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不过，坦白地说出来就能算是温柔吗…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-e28","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-e28"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"对着为了我，而如此这般努力的妈妈，\n告诉她我其实讨厌土豆，这样就是温柔吗…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-ee9","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-ee9"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在这之后，我来到商店帮姬子购买东西。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-f34","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-f34"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"从电梯到达7楼，\n正打算前往谈话室的时候。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-fc2","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-fc2"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…那是？」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-1007","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-1007"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"走廊的末端，谈话室的前面。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-103a","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-103a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"姬子，似乎正在和某人对话。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-1075","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-1075"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…记得那个人是…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-109c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-109c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"前几天和我说话的，像是陪护的人。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-10df","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-10df"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"看到不知道在说着什么的两个人，\n我想着打算靠近些打个招呼…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-114b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-114b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"但不知为何，有种气氛不对的感觉，\n 于是，我不由得躲在稍远处偷偷看他们。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-1218","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-1218"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「你看，今天一天的点滴，还没用完哦」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-1281","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-1281"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「我知道啦，我这不正在回去的嘛」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar2_07\",\"main\"]/mjo-12ec","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar2_07","sectionId":"main","eventId":"mjo-12ec"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「还有，关于午后的入浴方式…」","speaker":"旁白"}},{"key":