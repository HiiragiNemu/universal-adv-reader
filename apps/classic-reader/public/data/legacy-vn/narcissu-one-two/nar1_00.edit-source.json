/derived/scripts/patch-archives/narci_onetwo/update.arc.unpacked/nar1_00.strings.json","sha256":"df08f59010c0e68b0c547e2f088caedc0098f91797ecb9dd446750790306851a"},{"path":"archive/derived/scripts/patches/narci_onetwo/#mjo/nar1_00.plain.mjo","sha256":"a6334d532099d1e9ad744a6305e9564c31aa7229d6f7a85a59f789ebbd0cc668"},{"path":"archive/derived/scripts/patches/narci_onetwo/#mjo/nar1_00.script.json","sha256":"18311bff6c2e2af4092dbac684f742172e09908ae84c8b0423b6699363df6a53"},{"path":"archive/derived/scripts/patches/narci_onetwo/#mjo/nar1_00.strings.json","sha256":"497a9ee4efb0c47b2cdbae472de35650b1675845ab57729e17202d31c3db3979"},{"path":"archive/raw/narcissu10-original-ja-JP/narci_onetwo/scenario.arc.unpacked/nar1_00.mjo","sha256":"6bf5787b408c232cbe6c928d86934ce72ab60a27ee71115dd8462c7fa2deff51"},{"path":"archive/raw/narcissu10-original/narci_onetwo/scenario.arc.unpacked/nar1_00.mjo","sha256":"27b90f51cc5372ff9e45bca45dcdb74a47e966c13765d63ed114189ba17a972d"},{"path":"archive/raw/patch-archives/narci_onetwo/update.arc.unpacked/nar1_00.mjo","sha256":"58fb0c55ef22d1f56767ba06e43e4750c13f2db3056829679f043e8219764031"},{"path":"archive/raw/patches/narci_onetwo/#mjo/nar1_00.mjo","sha256":"6bf5787b408c232cbe6c928d86934ce72ab60a27ee71115dd8462c7fa2deff51"}],"rows":[{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/header","target":null,"allowed":[],"speakerReason":"structural-row","baseline":{"text":"--- Start: nar1_00.txt Section 1 ---","speaker":""}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-269","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-269"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"■　１９９６年　春　濑津美　■","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-307","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-307"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「『…的确，从小时候起，我的身体就不是很好…』」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-350","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-350"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"但也和别人一样上了小学，\n也有过暑假的时候一直玩耍到皮肤被晒黑。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-401","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-401"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"６月。刚刚进入初中的时候。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-434","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-434"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"预定从下个月开始游泳，要用到泳装的第二天。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-477","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-477"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那时，我经历了初次住院。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-4b2","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-4b2"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"那是第一学期期中考试不久前，\n下起了雨的，非常寒冷的日子","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-564","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-564"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"下着梅雨的苍白天空。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-58f","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-58f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"当然，在最开始的时候，\n班里的同学们几乎每天都会来探望我。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-5fd","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-5fd"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"出院的时候，\n每次周末，也会到我家里来玩。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-659","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-659"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…但是，这一切也只有一开始是这样。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-6b7","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-6b7"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"迎接秋天，跨过冬日\n住院，出院，检查…之后再次住院，就这样重复着…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-71f","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-71f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"曾经，那些被我当作『朋友』的同学们","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-75c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-75c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在不知不觉中，变成了『熟人』。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-793","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-793"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"最终，成为了『陌生人』。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-7c4","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-7c4"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"每当岁月更替\n我从他们的记忆中逐渐的消逝","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-87a","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-87a"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…看来，他们似乎『不喜欢』我」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-8f3","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-8f3"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「对普通人来说，我的存在只是一个累赘」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-98c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-98c"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「所以…仿佛从记忆里消失了一样…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-a4b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-a4b"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「在这个只看得到自己的世界里…\n　我送走了不知多少个季节…多少次下着梅雨的苍白天空…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-ae1","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-ae1"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「我的英语教科书，\n自１年级的期中考试以后，就只是一片空白」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-baa","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-baa"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「…从那时起…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-bf9","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-bf9"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我的时间静止了」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-d21","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-d21"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"■　８年后…２００４年　主人公　初夏　■","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-d89","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-d89"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"夏日。满身是汗。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-dae","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-dae"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"驾照考场的现场，放置着一块巨大的电子公告板。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-df3","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-df3"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"当公告板的LED灯同时亮起。\n我和其他人一样，寻找着自己的考号。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-e76","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-e76"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「２３７，２３７…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-ea1","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-ea1"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在将近最后的LED荧屏里，\n我顺利的找到了自己亮起的考号。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-f59","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-f59"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"咣当咣当、","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-f7e","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-f7e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"刚好到了午后时间，车内尤其冷清。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-fbf","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-fbf"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在这空旷冷清的车厢内，\n从考场出来的我开始了归途。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1021","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1021"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"左手握着刚刚收到的交规课本，\n胸前的口袋里揣着崭新的驾照。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1092","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1092"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「我现在也算是有驾照的人了…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-10c5","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-10c5"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"认真地嘟哝着，却也并没有什么感慨。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1100","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1100"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我不是很想要开车。\n也并非有着什么其他的目的。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-116c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-116c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"只是周围有很多人都去了驾校，\n而且他们经常劝我也去考一张驾照。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-121e","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-121e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这天夜里。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-123d","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-123d"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我将获得驾照的事情告诉了父母，\n『是吗』，被如此简短的回应了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-12a3","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-12a3"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我试着问到，能否借用父亲的车子，\n得到了同样简短的回答，","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-12f7","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-12f7"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不行。这样回复了我。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1326","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1326"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"其实我也并不是想开车，\n而他们的答复也和我的预想如出一辙。这就是我的父母。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-13c6","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-13c6"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"第二天。\n醒来后觉得胸口很难受，于是就去了医院。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1422","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1422"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在平时，我就很少生病。\n所以，初诊时的候诊时间让我感到百无聊赖。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-14d4","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-14d4"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"好不容易等到诊察结束了的样子，\n接下来却是胸透和血液检查。是被迫去检查的。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-154c","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-154c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"然后，经过漫长的时间，静静的等待者……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-158b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-158b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不知不觉，当我读完等候室的三本JUMP，\n向第四本伸手时，","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-15f7","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-15f7"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"就这样办理完了我的住院手续。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1630","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1630"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"一直放在胸口的口袋里的，那张崭新的驾照。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-167b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-167b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"看来暂时不会有使用到它的机会了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-172f","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-172f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"■　主人公　２００４年　秋　■","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-17a5","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-17a5"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"到了蝉鸣的喧嚣渐渐平静下来的时节。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-17e0","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-17e0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我仍然待在医院之中。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1811","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1811"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"当然了，我也不是一直都住在医院里。\n只是不停地重复着入院与出院的过程。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1881","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1881"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"上个月，我经历了平生的第一次手术。\n出院后，要去离家５分钟车程的医院去接受定期检查。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-18f9","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-18f9"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"之后便是住院，出院，检查，住院的循环…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1948","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1948"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"尽管不知道ＰＥＴ啊易瑞沙啊都是些什么东西，\n等回过神来，这单调的循环已经持续了几个月。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-19c6","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-19c6"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"与食欲越来越差相对应，服用药物的量与种类与日俱增。\n我自己也能实际感受到，体力明显下降了","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1a50","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1a50"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我发觉双腿越来越消瘦，","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1a83","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1a83"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"“这并不是错觉”，\n体重计的指针告诉我。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1ae3","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1ae3"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"但是…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1afc","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1afc"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"像是旁观者一般看着这一切。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1b31","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1b31"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"与其说是旁观的那种冷漠，\n简直就如同只是在看着电视里播出的一段镜头似的。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1b93","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1b93"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"事发突然，身上发生的事情，脑袋还没有反应过来。\n我无法对发生的这一切产生任何的实感。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1c15","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1c15"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"所以，尽管是发生在自己身上的事情，\n但我看待它的方式却仿佛自己是局外人似的。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1cd4","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1cd4"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"隆冬时节。\n当街头巷尾的圣诞气氛终于消散殆尽的时候，","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1d2a","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1d2a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"大概是因为到了年末了吧，我被允许回家了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1d6f","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1d6f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"当然这也只是暂时的。\n即便如此我还是感到了一丝喜悦。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1dff","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1dff"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在雨雪交加的天气，\n我回到了久违的家中。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1e59","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1e59"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不知道为什么，家人全都聚在一块。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1e8e","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1e8e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"明明平时很少和我说话的父母，\n总觉得有点不自然地，笑着迎接我。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1f14","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1f14"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"平日里没少和我拌嘴的妹妹，\n也做好了我最爱吃的奶油炖菜和炸虾排。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-1f96","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-1f96"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"大家一起围坐在被炉边。抢着为我剥橘子皮。\n那异乎寻常的照顾。留给了我很深的印象。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2010","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2010"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这时…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2029","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2029"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我隐约察觉到了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2054","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2054"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"静静地待在口袋里的，那张崭新的驾照。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-209d","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-209d"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这张驾照，不出意外的话，\n永远都不会有它的用武之地了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2131","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2131"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"面对着这些不自然的笑容…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2172","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2172"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我冷静地，茫然地，漠不关心地思索着，\n仿佛这是别人的事情。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2223","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2223"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"■　主人公　２００５年　１月　■","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-228e","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-228e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"新年过后，我再次回到了医院里。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-22c5","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-22c5"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不知为何，我并没有像以往那样被送到４楼，\n而是被带到了像谈话室一样的房间中。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-233b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-233b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"然后，爸爸和医生反复地交谈着，\n我夹在他们中间只是一直在听着。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-23b5","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-23b5"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这就是所谓的，病危通知吧。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-23f0","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-23f0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"他们拐弯抹角地说了一大堆，\n归结起来就是。我似乎快要死了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-245f","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-245f"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「是吗…」","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2486","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2486"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"所以，我只简短地回答了一句。也没能想到其他可以说的话了。\n直到走出谈话室为止，我也只说了这一句话。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2518","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2518"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"听到我的回答，\n医生拿起圆珠笔开始写着什么。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2574","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2574"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"大概是转入关怀病房的手续吧。\n他始终是一副事务性的态度。父亲的态度也与他相仿。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-25fa","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-25fa"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…人的死，原来这么简单啊…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-262b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-262b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"这是我发自内心的感想。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2686","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2686"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"然后，从这一天开始我由４楼转入了７楼，\n由６人病房变成了单人间。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2725","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2725"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"而且，７楼与其他的楼层稍微有些不一样。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-276a","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-276a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"首先，地板被擦得很亮。\n天花板也比以前高得多，宽敞得多。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-27de","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-27de"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"病房里面也非常漂亮，还有个很大窗户，\n日光透过巨大的玻璃窗射进屋内。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2860","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2860"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…但是，窗户却只能拉开一点。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-289b","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-289b"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我试了试，\n刚好是要伸出头还差点距离的宽度。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-28fd","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-28fd"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"还有就是，识别用手环的颜色也变了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2938","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2938"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"从入院那天开始，我手腕上就一直佩戴着一只塑料手环。\n上面记载着我的姓名和血型。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-29bc","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-29bc"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"现在，它的颜色由蓝色换成了白色。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2a19","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2a19"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"…宽敞的房间，白色的塑料手环，仅能拉开１５ｃｍ的窗户。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2a68","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2a68"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"正当我来搬到７楼，\n又到了，每年电视台开始播放无聊的春节节目的时候。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_onetwo/%23mjo/nar1_00\",\"main\"]/mjo-2ad8","target":{"variantId":"mjo/patches/narci_onetwo/%23mjo/nar1_00","sectionId":"main","eventId":"mjo-2ad8"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"也正是在这新年伊始的时候，\n我结识了那位女孩…","speaker":"旁白"}}]}
