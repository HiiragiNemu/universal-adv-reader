cripts/patch-archives/narci_zero/update.arc.unpacked/4atogaki.strings.json","sha256":"06439508a8dc3db45e46b68e73664645985f91f97c048bfb113665389fe702c1"},{"path":"archive/derived/scripts/patches/narci_zero/#mjo/4atogaki.plain.mjo","sha256":"27498ee5a9cceec9c94672910adf76055addea23213b14a046d041af44da3a04"},{"path":"archive/derived/scripts/patches/narci_zero/#mjo/4atogaki.script.json","sha256":"b437d750e68529f5aa618451997550b5b49cb4c20a59ef3f50fd2d20079aae4a"},{"path":"archive/derived/scripts/patches/narci_zero/#mjo/4atogaki.strings.json","sha256":"e306cc424bd2fa60740f8f9476fcfcb9217ef9c5a28a1452a7854f2b1404540b"},{"path":"archive/raw/narcissu10-original-ja-JP/narci_zero/scenario.arc.unpacked/4atogaki.mjo","sha256":"f4d4197113cfd7a44c2a559d04eda3e910ab56d3230193021326d06c0d22e358"},{"path":"archive/raw/narcissu10-original/narci_zero/scenario.arc.unpacked/4atogaki.mjo","sha256":"08134f886009419525a02d84c646ef501ce04c99290c41c768ce2c5a1162fc02"},{"path":"archive/raw/patch-archives/narci_zero/update.arc.unpacked/4atogaki.mjo","sha256":"9d15a70cef87081a9c29be6b06e633930b53446e4ec625c403e89b61ea453256"},{"path":"archive/raw/patches/narci_zero/#mjo/4atogaki.mjo","sha256":"f4d4197113cfd7a44c2a559d04eda3e910ab56d3230193021326d06c0d22e358"}],"rows":[{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/header","target":null,"allowed":[],"speakerReason":"structural-row","baseline":{"text":"--- Start: 4atogaki.txt Section 1 ---","speaker":""}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-70","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-70"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"■　后 记","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-135","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-135"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「大家好，我是片冈智！」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-1aa","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-1aa"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「这次，大家能观看支持narcissuＺＥＲＯ，\n　非常感谢！」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-258","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-258"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「原本是之前ＰＳＰ版的时候写的故事，\n所以有时我也叫它narcissu４……」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-30e","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-30e"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「重要的是，我认为它起到了对narcissu总结的作用」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-438","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-438"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「顺便一提，作为narcissu的舞台的７楼……也就是临终关怀院，\n在日本是１９７０年代开始的」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-4f8","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-4f8"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「这就像现在一样，在这项制度确立之前，\n经过了许多人的付出和努力」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-5a8","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-5a8"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「说起来，narcissu的舞台有原型吗？\n　经常会被问起这个问题……」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-65e","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-65e"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「这是以大阪的淀川基督教医院为原型的。\n　已经服务了很长时间了」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-70c","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-70c"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「关于这个故事也是，大约一半是非虚构的，\n事实上，登场人物也是有原型的……」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-7cc","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-7cc"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「还有，在narcissu小说版里，会有莳绘的女儿，\n　追赶奔向淡路岛的濑津美他们的场景」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-88c","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-88c"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「以后，濑津美的母亲，也和莳绘家的女儿关系很好」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-913","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-913"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「而且，在濑津美去世之后，\n　会有莳绘先生去拜访她母亲的一个场景……」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-9a2","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-9a2"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「就把这个场景放在这里吧」","speaker":"智"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-a4f","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-a4f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"―那是，那孩子去世之后第二年的事。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-a8e","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-a8e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"突然，家门前有人打招呼。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-af3","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-af3"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「是佐仓……濑津美小姐的家人吗？」","speaker":"４主人公"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-b63","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-b63"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯，是的……」","speaker":"濑津美母亲"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-b94","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-b94"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"回头一看，是一个年长的男性。\n并不是什么眼熟的人。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-bfc","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-bfc"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……到底，有什么事呢？","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-c33","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-c33"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"首先，已经几乎没有人来问那孩子的事了\n况且过了这么长时间了，心里也很难有头绪。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-ced","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-ced"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「不好意思……我姓莳绘……」","speaker":"４主人公"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-d5f","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-d5f"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……莳绘先生？」","speaker":"濑津美母亲"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-db8","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-db8"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯，担任医院的医疗部长」","speaker":"４主人公"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-df5","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-df5"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"听到这里，就和之前的事联系上了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-e2a","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-e2a"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"因为莳绘这个独特的姓氏，只能联想到她。\n她的父亲，听说也是那个医院的工作人员。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-eb0","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-eb0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……大概这个人，是她的父亲，是为了她女儿来的吧。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-f09","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-f09"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"从那之后她几乎每天都来家里，\n如果是这个年纪的女儿的父亲，会担心也不难理解。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-f8d","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-f8d"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"正那么想着……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-fc0","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-fc0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"非常意外地，这个人说的话却有点出乎意料。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-1031","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-1031"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「实际上，我和您家的女儿有过约定……」","speaker":"４主人公"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-10b3","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-10b3"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……女儿……是说我们家那孩子，濑津美吗？」","speaker":"濑津美母亲"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-112a","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-112a"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「嗯，稍微打扰一下可以吗？」","speaker":"４主人公"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-1193","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-1193"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……和我们家那孩子的约定？","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-11be","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-11be"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"听说莳绘小姐自己，和濑津美应该是没有直接交流的……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-121d","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-121d"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"濑津美和这个做父亲的人，到底有着怎样的联系呢？","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-1270","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-1270"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"说起来，医疗部长在医院应该也是很重要的职位吧。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-12b5","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-12b5"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"虽然不太明白，我还是请他到那个孩子的房间里。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-1335","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-1335"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"女儿的房间。\n自从那孩子去世，转眼已过去一年了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-13c7","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-13c7"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「这里一定还是女儿去世时候的样子吧」","speaker":"４主人公"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-143f","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-143f"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……是的。总觉得去收拾的话会很凄凉」","speaker":"濑津美母亲"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/4atogaki\",\"main\"]/mjo-14b8","target":{"variantId":"mjo/patches/narci_zero/%23mjo/4atogaki","sectionId":"main","eventId":"mjo-14b8"},"allowed"