tch-archives/narci_zero/update.arc.unpacked/nar4_00.strings.json","sha256":"81eb7872039d369ab3f4fabbfafb6bca62899787c4c8c31d63bf65f618348bfe"},{"path":"archive/derived/scripts/patches/narci_zero/#mjo/nar4_00.plain.mjo","sha256":"020ef4122a7056acd021baee69dd4d2e9b916224baf77c2b1efadccbe455861c"},{"path":"archive/derived/scripts/patches/narci_zero/#mjo/nar4_00.script.json","sha256":"9abf6fe69787ec25a4ccf18e4f1891a8c6f19bc6abdc15d49a8a3e5a11f51f9f"},{"path":"archive/derived/scripts/patches/narci_zero/#mjo/nar4_00.strings.json","sha256":"d4ed876af6f37f68bf7be11f8b0aadc57faf79f6dd214a79b68675a59ce8936d"},{"path":"archive/raw/narcissu10-original-ja-JP/narci_zero/scenario.arc.unpacked/nar4_00.mjo","sha256":"7003b7fe98777e9762e85660c763d3da8a1440806faa21b67f306c3669b434c0"},{"path":"archive/raw/narcissu10-original/narci_zero/scenario.arc.unpacked/nar4_00.mjo","sha256":"a814785c057968ad4297d4dc4ec70056b3da7f0d3d272a4a9194d1595e9c3b6c"},{"path":"archive/raw/patch-archives/narci_zero/update.arc.unpacked/nar4_00.mjo","sha256":"59eb03f5b2372a1232f3bf80ebfc1ab24554aee85c62b64f2418f8c0b1419c95"},{"path":"archive/raw/patches/narci_zero/#mjo/nar4_00.mjo","sha256":"7003b7fe98777e9762e85660c763d3da8a1440806faa21b67f306c3669b434c0"}],"rows":[{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/header","target":null,"allowed":[],"speakerReason":"structural-row","baseline":{"text":"--- Start: nar4_00.txt Section 1 ---","speaker":""}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-60","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-60"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……人只有在意识到自己的死亡时，才会体会到活着的感觉吧。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-103","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-103"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「虽然只是一句老套的话……但如今，我切身地体会到了这一点」","speaker":"●●阳子"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-1b5","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-1b5"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「那个时候，我想留给人的选择一定已所剩无几……」","speaker":"●●阳子"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-230","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-230"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「想要不被任何人察觉，不留下任何痕迹地，悄悄地离去……」","speaker":"●●阳子"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-2e2","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-2e2"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「又或是，想要留下曾经活着的证明」","speaker":"●●阳子"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-37e","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-37e"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「一定是从这两者中选其一吧」","speaker":"●●阳子"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-3b3","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-3b3"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"向来没有其他的选项。\n我也不知道哪一个是正确答案。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-413","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-413"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"是想要悄然离去，还是期望留下某些证明……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-498","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-498"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「我……选择了后者」","speaker":"●●阳子"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-4c9","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-4c9"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"只是，仅此而已。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-4f6","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-4f6"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"不，准确来说最开始是前者。\n但逐渐转变成了后者……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-600","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-600"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"11月清澈的天空。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-629","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-629"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"吹拂的风，也将要正式染上冬天的气息。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-672","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-672"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"中庭。\n我一如往常地正在给花坛浇水…","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-6f9","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-6f9"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「今天也是个好天气啊……」","speaker":"阿姨"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-728","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-728"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"有位女士向我搭话。\n是位偶尔在谈话室说过话的，面熟的人。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-7cd","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-7cd"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「哎，可以的话，能收下这个吗？」","speaker":"阿姨"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-80c","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-80c"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我看了一下，是一本诗集。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-83f","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-83f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"因为她总是将这本书带在身边，想必是本她心爱的书。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-894","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-894"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"但是，我没有收下它的理由。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-8fb","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-8fb"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……为什么……要给我？」","speaker":"濑津美"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-961","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-961"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「因为你看上去，是个喜欢读书的人……而且也没有其他能给的人了……」","speaker":"阿姨"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-9bc","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-9bc"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"说完，她用手指了指我手上拿着的地图和图鉴一类的东西。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-a40","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-a40"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「毕竟，给其他人的话……收下了也会感觉很为难吧？」","speaker":"阿姨"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-ab9","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-ab9"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「是啊…………会很为难呢」","speaker":"濑津美"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-af0","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-af0"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我对她的话表示同意，并收下了书。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-b2f","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-b2f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在我接过书时，她那像是寂寞，又像是欣喜的……\n十分复杂的表情，给我留下了深刻的印象。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-bb9","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-bb9"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"花坛前，仍然日头高照。\n属于一段同为白手环佩戴者之间的对话。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-c56","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-c56"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「那么，我也差不多该走了」","speaker":"阿姨"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-cb4","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-cb4"},"allowed":["text","speaker"],"speakerReason":"separate-native-message","baseline":{"text":"「……嗯」","speaker":"濑津美"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-cf9","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-cf9"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"说完这句话后，那位女士向家人身边走去。\n即使是同样戴着白手环的人，但这是她第三次临时出院。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-d81","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-d81"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……恐怕，已经不会再次见面了吧。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-dc6","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-dc6"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"我把收下的书放到长椅上，再次拿起了喷水壶。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-e62","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-e62"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在所有的花都已经凋零的时候，\n一朵孤零零的水仙花，孤零零地开着。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-ec2","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-ec2"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"明明还没有到正式的花期，\n却已经开始绽放出星星点点的白花。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-f30","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-f30"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……曾经，和姬子小姐一起种下的这些花儿。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-f6f","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-f6f"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"在那之后又绽开多少次了呢？","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-faa","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-faa"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"―水仙正式的花期是1月到３月。\n虽然能用种子栽培，但还是以鳞茎栽培为主。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-101e","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-101e"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"还有……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-1035","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-1035"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"……花语是爱自己。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-1060","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-1060"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"尽管迄今为止这些年，我一直能见到这些花的身姿……\n总觉得今年似乎有些困难了。","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-10d2","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-10d2"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"text":"是这些花会先绽放和凋零呢……\n还是，我会先死去呢……","speaker":"旁白"}},{"key":"[\"mjo/patches/narci_zero/%23mjo/nar4_00\",\"main\"]/mjo-1142","target":{"variantId":"mjo/patches/narci_zero/%23mjo/nar4_00","sectionId":"main","eventId":"mjo-1142"},"allowed":["text"],"speakerReason":"no-native-speaker","baseline":{"t