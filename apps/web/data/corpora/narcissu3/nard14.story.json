                "mjoAnchor": "mjo-537"
              }
            },
            {
              "eventId": "line-018",
              "kind": "line",
              "text": {
                "ja-JP": "そう言い聞かせ、これが正しいんだと、わたしは正しい判断をしたんだと言い聞かせる。"
              },
              "nextEventId": "line-019",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
