              }
            },
            {
              "eventId": "line-017",
              "kind": "line",
              "text": {
                "ja-JP": "そうする事があの人のためでもあるんだ。"
              },
              "nextEventId": "line-018",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
