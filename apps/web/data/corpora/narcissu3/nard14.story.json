                "textCodeOffset": 1575,
                "mjoAnchor": "mjo-627"
              }
            },
            {
              "eventId": "line-022",
              "kind": "line",
              "text": {
                "ja-JP": "わたしにはそれがとても皮肉の効いた、質の悪い冗談に\n聞こえてならななかった。"
              },
              "nextEventId": "line-023",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
                "scriptPath": "archive/derived/scripts/narcissu3/scenario.arc.unpacked/nard14.script.json",
                "textEventIndices": [
