                ],
                "textCodeOffset": 1681,
                "mjoAnchor": "mjo-691"
              }
            },
            {
              "eventId": "line-023",
              "kind": "line",
              "text": {
                "ja-JP": "…わたしは正規の手順で、１つ１つ相殺する事ですじ雲の\n高さに到達する事は出来なかった。"
              },
              "nextEventId": "line-024",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
                "scriptPath": "archive/derived/scripts/narcissu3/scenario.arc.unpacked/nard14.script.json",
