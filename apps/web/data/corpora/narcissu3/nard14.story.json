            {
              "eventId": "line-008",
              "kind": "line",
              "text": {
                "ja-JP": "――暗く、肌寒い部屋の中。"
              },
              "nextEventId": "line-009",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
