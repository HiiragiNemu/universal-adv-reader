                ],
                "textCodeOffset": 1127,
                "mjoAnchor": "mjo-467"
              }
            },
            {
              "eventId": "line-015",
              "kind": "line",
              "text": {
                "ja-JP": "そして本当に辛い事というのは喋る側も聞く側もこんなに\n大変なんだと痛感した。"
              },
              "nextEventId": "line-016",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
                "scriptPath": "archive/derived/scripts/narcissu3/scenario.arc.unpacked/nard14.script.json",
