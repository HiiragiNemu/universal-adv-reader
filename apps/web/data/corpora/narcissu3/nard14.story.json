                "mjoAnchor": "mjo-7be"
              }
            },
            {
              "eventId": "line-026",
              "kind": "line",
              "text": {
                "ja-JP": "そこは捉え方によっては上空７０００ｍよりも地上の生活\nから遠い場所。"
              },
              "nextEventId": "line-027",
              "source": {
                "engine": "majiro",
