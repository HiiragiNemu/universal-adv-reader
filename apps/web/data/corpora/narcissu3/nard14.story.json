                ],
                "textCodeOffset": 788,
                "mjoAnchor": "mjo-314"
              }
            },
            {
              "eventId": "line-010",
              "kind": "line",
              "text": {
                "ja-JP": "それは今日までの出来事、今日の出来事、明日の事、そして明日以降の事について…と実に様々。"
              },
              "nextEventId": "line-011",
              "source": {
                "engine": "majiro",
                "variantSourceId": "mjo/narcissu3/scenario.arc.unpacked/nard14",
                "scriptPath": "archive/derived/scripts/narcissu3/scenario.arc.unpacked/nard14.script.json",
