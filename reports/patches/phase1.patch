+import { validateStoryDocument } from '../../contracts/src/index.js';
+
+export function createAdvIrAdapter() {
+  return Object.freeze({
+    id: 'adv-ir-v1',
+    sourceFormats: Object.freeze(['adv-story/v1']),
+    async load({ storyEntry, io }) {
+      if (typeof io?.fetchJson !== 'function') {
+        throw new TypeError('adv-ir-v1 requires io.fetchJson');
+      }
+      const story = await io.fetchJson(storyEntry.source);
+      return validateStoryDocument(story);
+    },
+  });
+}
diff --git a/packages/bridge/src/client.js b/packages/bridge/src/client.js
new file mode 100644
index 0000000000000000000000000000000000000000..f460d43d0a981d31102c83294d7cccc71ac94e29
--- /dev/null
+++ b/packages/bridge/src/client.js
@@ -0,0 +1,87 @@
+import {
+  BRIDGE_CHANNEL,
+  BRIDGE_VERSION,
+  connectMessage,
+  requestMessage,
+} from './protocol.js';
+
+const randomId = () => globalThis.crypto?.randomUUID?.()
+  ?? `request-${Date.now()}-${Math.random().toString(16).slice(2)}`;
+
+export async function connectToAdvApp({
+  targetWindow,
+  targetOrigin,
+  timeoutMs = 5_000,
+  messageChannelFactory = () => new MessageChannel(),
+}) {
+  if (!targetWindow?.postMessage) throw new TypeError('targetWindow is required');
+  if (typeof targetOrigin !== 'string' || !targetOrigin) throw new TypeError('targetOrigin is required');
+  const channel = messageChannelFactory();
+  const port = channel.port1;
+  const pending = new Map();
+  const connectId = randomId();
+  let closed = false;
+
+  const connected = new Promise((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error('bridge connection timed out')), timeoutMs);
+    port.onmessage = (event) => {
+      const message = event.data;
+      if (
+        message?.channel !== BRIDGE_CHANNEL
+        || message?.version !== BRIDGE_VERSION
+      ) return;
+      if (message.type === 'connected' && message.requestId === connectId) {
+        clearTimeout(timer);
+        resolve(message);
+        return;
+      }
+      if (message.type === 'response' && pending.has(message.requestId)) {
+        const request = pending.get(message.requestId);
+        pending.delete(message.requestId);
+        clearTimeout(request.timer);
+        if (message.ok) request.resolve(message.result);
+        else request.reject(new Error(message.error?.message ?? 'bridge request failed'));
+        return;
+      }
+      if (message.type === 'event') {
+        for (const listener of [...listeners]) listener(message.name, message.payload);
+      }
+    };
+    port.start?.();
+    targetWindow.postMessage(connectMessage(connectId), targetOrigin, [channel.port2]);
+  });
+
+  const listeners = new Set();
+  const metadata = await connected;
+  return Object.freeze({
+    appId: metadata.appId,
+    capabilities: Object.freeze([...(metadata.capabilities ?? [])]),
+    request(action, payload = {}) {
+      if (closed) return Promise.reject(new Error('bridge client is closed'));
+      const requestId = randomId();
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => {
+          pending.delete(requestId);
+          reject(new Error(`bridge action ${action} timed out`));
+        }, timeoutMs);
+        pending.set(requestId, { resolve, reject, timer });
+        port.postMessage(requestMessage(requestId, action, payload));
+      });
+    },
+    onEvent(listener) {
+      listeners.add(listener);
+      return () => listeners.delete(listener);
+    },
+    close() {
+      if (closed) return;
+      closed = true;
+      for (const request of pending.values()) {
+        clearTimeout(request.timer);
+        request.reject(new Error('bridge client closed'));
+      }
+      pending.clear();
+      listeners.clear();
+      port.close?.();
+    },
+  });
+}
diff --git a/packages/bridge/src/deep-link.js b/packages/bridge/src/deep-link.js
new file mode 100644
index 0000000000000000000000000000000000000000..3e3ba74c566b2c816838bb916b9f5e81d94757f1
--- /dev/null
+++ b/packages/bridge/src/deep-link.js
@@ -0,0 +1,70 @@
+export const BRIDGE_REVISION = 'adv-app-bridge-1';
+export const LOCATION_PARAMETERS = Object.freeze([
+  'canonicalStoryId',
+  'variantId',
+  'sectionId',
+  'eventId',
+  'storyRevision',
+  'catalogRevision',
+  'bridgeRevision',
+]);
+
+const PATH_ID_RE = /^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$/u;
+const SIMPLE_ID_RE = /^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$/u;
+const pathKeys = new Set(['canonicalStoryId', 'variantId']);
+
+const validValue = (key, value) => {
+  if (typeof value !== 'string' || value.length === 0) return false;
+  return pathKeys.has(key) ? PATH_ID_RE.test(value) : SIMPLE_ID_RE.test(value);
+};
+
+export function parseStoryDeepLink(input, expected = {}) {
+  const url = input instanceof URL ? new URL(input.href) : new URL(input, 'https://reader.invalid');
+  const canonicalStoryId = url.searchParams.get('canonicalStoryId');
+  if (!canonicalStoryId) return null;
+  const location = {};
+  for (const key of LOCATION_PARAMETERS) {
+    const value = url.searchParams.get(key);
+    if (value === null) continue;
+    if (!validValue(key, value)) throw new TypeError(`invalid deep-link parameter ${key}`);
+    location[key] = value;
+  }
+  const revision = {
+    bridge: location.bridgeRevision === undefined || expected.bridgeRevision === undefined
+      ? 'unknown'
+      : location.bridgeRevision === expected.bridgeRevision ? 'exact' : 'mismatch',
+    story: location.storyRevision === undefined || expected.storyRevision === undefined
+      ? 'unknown'
+      : location.storyRevision === expected.storyRevision ? 'exact' : 'mismatch',
+    catalog: location.catalogRevision === undefined || expected.catalogRevision === undefined
+      ? 'unknown'
+      : location.catalogRevision === expected.catalogRevision ? 'exact' : 'mismatch',
+  };
+  return { location, revision };
+}
+
+export function buildStoryDeepLink(input, location, revisions = {}) {
+  const url = input instanceof URL ? new URL(input.href) : new URL(input, 'https://reader.invalid');
+  const values = {
+    ...location,
+    storyRevision: revisions.storyRevision ?? location.storyRevision,
+    catalogRevision: revisions.catalogRevision ?? location.catalogRevision,
+    bridgeRevision: revisions.bridgeRevision ?? location.bridgeRevision ?? BRIDGE_REVISION,
+  };
+  for (const key of LOCATION_PARAMETERS) {
+    const value = values[key];
+    if (value === undefined || value === null || value === '') {
+      url.searchParams.delete(key);
+      continue;
+    }
+    if (!validValue(key, value)) throw new TypeError(`invalid deep-link parameter ${key}`);
+    url.searchParams.set(key, value);
+  }
+  return url;
+}
+
+export function canSynchronizeExactEvent(revision) {
+  return revision.bridge !== 'mismatch'
+    && revision.story !== 'mismatch'
+    && revision.catalog !== 'mismatch';
+}
diff --git a/packages/bridge/src/protocol.js b/packages/bridge/src/protocol.js
new file mode 100644
index 0000000000000000000000000000000000000000..b2b5d70fb463bb4cb1ecb50f3b981dadb8e6f877
--- /dev/null
+++ b/packages/bridge/src/protocol.js
@@ -0,0 +1,72 @@
+export const BRIDGE_CHANNEL = 'adv-app-bridge';
+export const BRIDGE_VERSION = 1;
+export const BRIDGE_ACTIONS = Object.freeze([
+  'story.open',
+  'story.getLocation',
+  'voice.play',
+  'lifecycle.suspend',
+  'lifecycle.resume',
+  'lifecycle.dispose',
+]);
+
+const isRecord = (value) => value && typeof value === 'object' && !Array.isArray(value);
+const isRequestId = (value) => typeof value === 'string' && value.length > 0 && value.length <= 256;
+
+export const baseEnvelope = (type) => ({
+  channel: BRIDGE_CHANNEL,
+  version: BRIDGE_VERSION,
+  type,
+});
+
+export function isConnectMessage(value) {
+  return isRecord(value)
+    && value.channel === BRIDGE_CHANNEL
+    && value.version === BRIDGE_VERSION
+    && value.type === 'connect'
+    && isRequestId(value.requestId);
+}
+
+export function isRequestMessage(value) {
+  return isRecord(value)
+    && value.channel === BRIDGE_CHANNEL
+    && value.version === BRIDGE_VERSION
+    && value.type === 'request'
+    && isRequestId(value.requestId)
+    && BRIDGE_ACTIONS.includes(value.action)
+    && (value.payload === undefined || isRecord(value.payload));
+}
+
+export function connectMessage(requestId) {
+  return { ...baseEnvelope('connect'), requestId };
+}
+
+export function connectedMessage(requestId, appId, capabilities) {
+  return {
+    ...baseEnvelope('connected'),
+    requestId,
+    appId,
+    capabilities: [...capabilities],
+  };
+}
+
+export function requestMessage(requestId, action, payload = {}) {
+  if (!BRIDGE_ACTIONS.includes(action)) throw new TypeError(`unsupported bridge action ${action}`);
+  return { ...baseEnvelope('request'), requestId, action, payload };
+}
+
+export function responseMessage(requestId, result) {
+  return { ...baseEnvelope('response'), requestId, ok: true, result };
+}
+
+export function errorMessage(requestId, code, message) {
+  return {
+    ...baseEnvelope('response'),
+    requestId,
+    ok: false,
+    error: { code, message },
+  };
+}
+
+export function eventMessage(name, payload) {
+  return { ...baseEnvelope('event'), name, payload };
+}
