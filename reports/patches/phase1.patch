diff --git a/test/adapter-registry.test.js b/test/adapter-registry.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..a21a6ebe1f5f1567dcc030257a71e1a1c84af45b
--- /dev/null
+++ b/test/adapter-registry.test.js
@@ -0,0 +1,63 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { createAdvIrAdapter } from '../packages/adapters/src/adv-ir-v1.js';
+import { AdapterRegistry, AdapterRegistryError } from '../packages/core/src/adapter-registry.js';
+import { fixtureJson } from '../test-support/helpers.js';
+
+const inputs = async () => {
+  const catalog = await fixtureJson('catalog.json');
+  return {
+    corpus: catalog.corpora[0],
+    storyEntry: catalog.corpora[0].stories[0],
+    story: await fixtureJson('demo-story.json'),
+  };
+};
+
+test('adapter registry loads only the exact declared adapter and format', async () => {
+  const { corpus, storyEntry, story } = await inputs();
+  const registry = new AdapterRegistry();
+  registry.register(createAdvIrAdapter());
+
+  const loaded = await registry.loadStory(corpus, storyEntry, {
+    fetchJson: async (source) => {
+      assert.equal(source, './data/demo-story.json');
+      return story;
+    },
+  });
+  assert.equal(loaded.canonicalStoryId, 'demo/arrival');
+});
+
+test('adapter registry does not fall back to another installed adapter', async () => {
+  const { corpus, storyEntry, story } = await inputs();
+  let calls = 0;
+  const registry = new AdapterRegistry();
+  registry.register({
+    id: 'another-adapter',
+    sourceFormats: ['adv-story/v1'],
+    async load() {
+      calls += 1;
+      return story;
+    },
+  });
+
+  await assert.rejects(
+    registry.loadStory(corpus, storyEntry, { fetchJson: async () => story }),
+    (error) => error instanceof AdapterRegistryError
+      && error.message.includes('declared adapter "adv-ir-v1" is not installed'),
+  );
+  assert.equal(calls, 0);
+});
+
+test('adapter registry rejects an undeclared source format', async () => {
+  const { corpus, storyEntry, story } = await inputs();
+  const registry = new AdapterRegistry();
+  registry.register(createAdvIrAdapter());
+
+  await assert.rejects(
+    registry.loadStory({ ...corpus, sourceFormat: 'legacy-script/v9' }, storyEntry, {
+      fetchJson: async () => story,
+    }),
+    /does not accept source format/,
+  );
+});
diff --git a/test/audio-controller.test.js b/test/audio-controller.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..65e6d32424b34a39c9f5c58fa3a4f155e82214b6
--- /dev/null
+++ b/test/audio-controller.test.js
@@ -0,0 +1,45 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { AudioController } from '../packages/core/src/audio-controller.js';
+
+class FakeAudioBackend {
+  stopped = false;
+  played = false;
+  ended = () => {};
+  failed = () => {};
+
+  onEnded(callback) { this.ended = callback; }
+  onError(callback) { this.failed = callback; }
+  async play() { this.played = true; }
+  stop() { this.stopped = true; }
+}
+
+test('audio controller maintains one primary channel and reports unresolved routes', async () => {
+  const backends = [];
+  const controller = new AudioController({
+    backendFactory() {
+      const backend = new FakeAudioBackend();
+      backends.push(backend);
+      return backend;
+    },
+  });
+  const cueA = { cueId: 'voice:a', kind: 'voice' };
+  const cueB = { cueId: 'voice:b', kind: 'voice' };
+  const route = { status: 'resolved', url: 'https://reader.example/a.wav' };
+
+  await controller.play(cueA, route);
+  assert.equal(controller.getSnapshot().status, 'playing');
+  await controller.play(cueB, route);
+  assert.equal(backends[0].stopped, true);
+  assert.equal(controller.getSnapshot().cueId, 'voice:b');
+
+  await controller.play(cueA, { status: 'unresolved', reason: 'not mapped' });
+  assert.equal(backends[1].stopped, true);
+  assert.deepEqual(controller.getSnapshot(), {
+    status: 'error',
+    cueId: 'voice:a',
+    error: 'not mapped',
+  });
+  controller.dispose();
+});
diff --git a/test/bridge.test.js b/test/bridge.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..974828272845ef8f791ac04e0bc9a484b85117de
--- /dev/null
+++ b/test/bridge.test.js
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { connectToAdvApp } from '../packages/bridge/src/client.js';
+import { connectMessage } from '../packages/bridge/src/protocol.js';
+import { attachBridgeProvider } from '../packages/bridge/src/provider.js';
+
+class LocalWindow {
+  location = { origin: 'https://reader.example' };
+  #listeners = new Set();
+
+  addEventListener(name, listener) {
+    if (name === 'message') this.#listeners.add(listener);
+  }
+
+  removeEventListener(name, listener) {
+    if (name === 'message') this.#listeners.delete(listener);
+  }
+
+  dispatch(data, origin, ports = []) {
+    for (const listener of [...this.#listeners]) listener({ data, origin, ports });
+  }
+
+  postMessage(data, targetOrigin, ports = []) {
+    assert.equal(targetOrigin, this.location.origin);
+    queueMicrotask(() => this.dispatch(data, this.location.origin, ports));
+  }
+}
+
+test('MessagePort provider rejects other origins and serves exact actions to same-origin clients', async () => {
+  const targetWindow = new LocalWindow();
+  const provider = attachBridgeProvider({
+    targetWindow,
+    appId: 'universal-adv-reader',
+    capabilities: ['story.read', 'voice.play'],
+    actions: {
+      'story.getLocation': async () => ({ eventId: 'line-001' }),
+    },
+  });
+
+  const rejectedChannel = new MessageChannel();
+  targetWindow.dispatch(connectMessage('untrusted'), 'https://other.example', [rejectedChannel.port2]);
+  await new Promise((resolve) => setTimeout(resolve, 10));
+  assert.equal(provider.connectionCount, 0);
+  rejectedChannel.port1.close();
+  rejectedChannel.port2.close();
+
+  const client = await connectToAdvApp({
+    targetWindow,
+    targetOrigin: targetWindow.location.origin,
+    timeoutMs: 500,
+  });
+  assert.equal(provider.connectionCount, 1);
+  assert.deepEqual(client.capabilities, ['story.read', 'voice.play']);
+  assert.deepEqual(await client.request('story.getLocation'), { eventId: 'line-001' });
+  await assert.rejects(client.request('story.open'), /story.open/);
+
+  client.close();
+  provider.dispose();
+});
