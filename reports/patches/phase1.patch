index 0000000000000000000000000000000000000000..0dbc52374fdc741f79fca8b6b63d5fe2f0be7f12
--- /dev/null
+++ b/packages/bridge/src/provider.js
@@ -0,0 +1,85 @@
+import {
+  connectedMessage,
+  errorMessage,
+  eventMessage,
+  isConnectMessage,
+  isRequestMessage,
+  responseMessage,
+} from './protocol.js';
+
+const exactOriginAllowed = (origin, allowedOrigins, ownOrigin) => {
+  if (origin === ownOrigin) return true;
+  return allowedOrigins.includes(origin);
+};
+
+export function attachBridgeProvider({
+  targetWindow = globalThis.window,
+  appId,
+  capabilities,
+  allowedOrigins = [],
+  actions,
+}) {
+  if (!targetWindow?.addEventListener) throw new TypeError('targetWindow is required');
+  if (typeof appId !== 'string' || !appId) throw new TypeError('appId is required');
+  const ports = new Set();
+  const ownOrigin = targetWindow.location?.origin ?? '';
+  let disposed = false;
+
+  const emit = (name, payload) => {
+    if (disposed) return;
+    const message = eventMessage(name, payload);
+    for (const port of [...ports]) port.postMessage(message);
+  };
+
+  const attachPort = (port, connect) => {
+    ports.add(port);
+    port.onmessage = async (event) => {
+      const message = event.data;
+      if (!isRequestMessage(message)) return;
+      const handler = actions[message.action];
+      if (typeof handler !== 'function') {
+        port.postMessage(errorMessage(message.requestId, 'unsupported-action', message.action));
+        return;
+      }
+      try {
+        const result = await handler(message.payload ?? {});
+        port.postMessage(responseMessage(message.requestId, result ?? null));
+      } catch (error) {
+        port.postMessage(errorMessage(
+          message.requestId,
+          'action-failed',
+          error instanceof Error ? error.message : String(error),
+        ));
+      }
+    };
+    port.onmessageerror = () => {
+      ports.delete(port);
+      port.close?.();
+    };
+    port.start?.();
+    port.postMessage(connectedMessage(connect.requestId, appId, capabilities));
+  };
+
+  const onWindowMessage = (event) => {
+    if (disposed || !isConnectMessage(event.data)) return;
+    if (!exactOriginAllowed(event.origin, allowedOrigins, ownOrigin)) return;
+    const [port] = event.ports ?? [];
+    if (!port) return;
+    attachPort(port, event.data);
+  };
+
+  targetWindow.addEventListener('message', onWindowMessage);
+  return Object.freeze({
+    emit,
+    dispose() {
+      if (disposed) return;
+      disposed = true;
+      targetWindow.removeEventListener('message', onWindowMessage);
+      for (const port of [...ports]) port.close?.();
+      ports.clear();
+    },
+    get connectionCount() {
+      return ports.size;
+    },
+  });
+}
diff --git a/packages/contracts/src/index.js b/packages/contracts/src/index.js
new file mode 100644
index 0000000000000000000000000000000000000000..94e8215c31854d658b14fb0a7a25cc944e6a9297
--- /dev/null
+++ b/packages/contracts/src/index.js
@@ -0,0 +1,255 @@
+export const STORY_SCHEMA = 'adv-story/v1';
+export const CATALOG_SCHEMA = 'adv-catalog/v1';
+export const MEDIA_SCHEMA = 'adv-media/v1';
+export const APP_MANIFEST_SCHEMA = 'adv-app-manifest/v1';
+
+export const EVENT_KINDS = Object.freeze(['line', 'choice', 'action', 'end']);
+export const MEDIA_KINDS = Object.freeze(['voice', 'bgm', 'sfx', 'image', 'video']);
+export const CUE_TIMINGS = Object.freeze(['utterance', 'scene']);
+
+const SIMPLE_ID_RE = /^[A-Za-z0-9][A-Za-z0-9_.:-]{0,191}$/u;
+const PATH_ID_RE = /^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,255}$/u;
+const LOCALE_RE = /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/u;
+
+export class ContractError extends Error {
+  constructor(path, reason) {
+    super(`${path}: ${reason}`);
+    this.name = 'ContractError';
+    this.path = path;
+  }
+}
+
+const fail = (path, reason) => {
+  throw new ContractError(path, reason);
+};
+
+const asRecord = (value, path) => {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    fail(path, 'must be an object');
+  }
+  return value;
+};
+
+const asArray = (value, path, { min = 0, max = 100_000 } = {}) => {
+  if (!Array.isArray(value) || value.length < min || value.length > max) {
+    fail(path, `must be an array with ${min}..${max} entries`);
+  }
+  return value;
+};
+
+const asString = (value, path, { min = 1, max = 200_000 } = {}) => {
+  if (typeof value !== 'string' || value.length < min || value.length > max) {
+    fail(path, `must be a string with ${min}..${max} characters`);
+  }
+  if (/\p{Cc}/u.test(value)) fail(path, 'contains a control character');
+  return value;
+};
+
+const asSimpleId = (value, path) => {
+  const text = asString(value, path, { max: 192 });
+  if (!SIMPLE_ID_RE.test(text)) fail(path, 'has an invalid identifier shape');
+  return text;
+};
+
+const asPathId = (value, path) => {
+  const text = asString(value, path, { max: 256 });
+  if (!PATH_ID_RE.test(text) || text.includes('//') || text.split('/').includes('..')) {
+    fail(path, 'has an invalid path identifier shape');
+  }
+  return text;
+};
+
+const assertUnique = (values, path) => {
+  const seen = new Set();
+  for (const value of values) {
+    if (seen.has(value)) fail(path, `contains duplicate ${JSON.stringify(value)}`);
+    seen.add(value);
+  }
+};
+
+export function validateLocalized(value, path = 'localized') {
+  const record = asRecord(value, path);
+  const entries = Object.entries(record);
+  if (entries.length === 0 || entries.length > 32) fail(path, 'must contain 1..32 locales');
+  for (const [locale, text] of entries) {
+    if (!LOCALE_RE.test(locale)) fail(`${path}.${locale}`, 'has an invalid locale');
+    asString(text, `${path}.${locale}`, { min: 0 });
+  }
+  return record;
+}
+
+function validateCue(value, path) {
+  const cue = asRecord(value, path);
+  asPathId(cue.cueId, `${path}.cueId`);
+  if (!MEDIA_KINDS.includes(cue.kind)) fail(`${path}.kind`, 'is not a supported media kind');
+  if (!CUE_TIMINGS.includes(cue.timing)) fail(`${path}.timing`, 'is not a supported timing');
+  if (cue.mediaId !== undefined) asPathId(cue.mediaId, `${path}.mediaId`);
+  if (cue.resolverId !== undefined) asSimpleId(cue.resolverId, `${path}.resolverId`);
+  if (cue.stopEventId !== undefined) asSimpleId(cue.stopEventId, `${path}.stopEventId`);
+  if (cue.raw !== undefined) asRecord(cue.raw, `${path}.raw`);
+  return cue;
+}
+
+function validateEvent(value, path) {
+  const event = asRecord(value, path);
+  asSimpleId(event.eventId, `${path}.eventId`);
+  if (!EVENT_KINDS.includes(event.kind)) fail(`${path}.kind`, 'is not a supported event kind');
+  if (event.speaker !== undefined) validateLocalized(event.speaker, `${path}.speaker`);
+  if (event.text !== undefined) validateLocalized(event.text, `${path}.text`);
+  if (event.nextEventId !== undefined) asSimpleId(event.nextEventId, `${path}.nextEventId`);
+  if (event.source !== undefined) asRecord(event.source, `${path}.source`);
+
+  const cues = event.cues === undefined ? [] : asArray(event.cues, `${path}.cues`, { max: 1024 });
+  cues.forEach((cue, index) => validateCue(cue, `${path}.cues[${index}]`));
+  assertUnique(cues.map((cue) => cue.cueId), `${path}.cues`);
+
+  if (event.kind === 'line' && event.text === undefined) fail(path, 'line event requires text');
+  if (event.kind === 'choice') {
+    const choices = asArray(event.choices, `${path}.choices`, { min: 1, max: 1024 });
+    choices.forEach((value, index) => {
+      const choicePath = `${path}.choices[${index}]`;
+      const choice = asRecord(value, choicePath);
+      asSimpleId(choice.choiceId, `${choicePath}.choiceId`);
+      validateLocalized(choice.label, `${choicePath}.label`);
+      asSimpleId(choice.nextEventId, `${choicePath}.nextEventId`);
+      const choiceCues = choice.cues === undefined
+        ? []
+        : asArray(choice.cues, `${choicePath}.cues`, { max: 128 });
+      choiceCues.forEach((cue, cueIndex) => validateCue(cue, `${choicePath}.cues[${cueIndex}]`));
+    });
+    assertUnique(choices.map((choice) => choice.choiceId), `${path}.choices`);
+  } else if (event.choices !== undefined) {
+    fail(`${path}.choices`, 'is only valid on a choice event');
+  }
+  if (event.kind === 'end' && event.nextEventId !== undefined) {
+    fail(`${path}.nextEventId`, 'end event cannot have a default edge');
+  }
+  return event;
+}
+
+export function validateStoryDocument(value) {
+  const story = asRecord(value, 'story');
+  if (story.schema !== STORY_SCHEMA) fail('story.schema', `must equal ${STORY_SCHEMA}`);
+  asSimpleId(story.corpusId, 'story.corpusId');
+  asPathId(story.canonicalStoryId, 'story.canonicalStoryId');
+  asSimpleId(story.adapterId, 'story.adapterId');
+  asSimpleId(story.revision, 'story.revision');
+  asString(story.title, 'story.title', { max: 512 });
+
+  const variants = asArray(story.variants, 'story.variants', { min: 1, max: 512 });
+  assertUnique(variants.map((variant) => asRecord(variant, 'story.variant').variantId), 'story.variants');
+
+  for (let variantIndex = 0; variantIndex < variants.length; variantIndex += 1) {
+    const path = `story.variants[${variantIndex}]`;
+    const variant = asRecord(variants[variantIndex], path);
+    asPathId(variant.variantId, `${path}.variantId`);
+    const locales = asArray(variant.locales, `${path}.locales`, { min: 1, max: 32 });
+    locales.forEach((locale, index) => {
+      if (typeof locale !== 'string' || !LOCALE_RE.test(locale)) {
+        fail(`${path}.locales[${index}]`, 'has an invalid locale');
+      }
+    });
+    assertUnique(locales, `${path}.locales`);
+
+    const sections = asArray(variant.sections, `${path}.sections`, { min: 1, max: 10_000 });
+    assertUnique(sections.map((section) => asRecord(section, `${path}.section`).sectionId), `${path}.sections`);
+    for (let sectionIndex = 0; sectionIndex < sections.length; sectionIndex += 1) {
+      const sectionPath = `${path}.sections[${sectionIndex}]`;
+      const section = asRecord(sections[sectionIndex], sectionPath);
+      asSimpleId(section.sectionId, `${sectionPath}.sectionId`);
+      validateLocalized(section.title, `${sectionPath}.title`);
+      asSimpleId(section.entryEventId, `${sectionPath}.entryEventId`);
+      const events = asArray(section.events, `${sectionPath}.events`, { min: 1, max: 1_000_000 });
+      events.forEach((event, index) => validateEvent(event, `${sectionPath}.events[${index}]`));
+      assertUnique(events.map((event) => event.eventId), `${sectionPath}.events`);
+      const eventIds = new Set(events.map((event) => event.eventId));
+      if (!eventIds.has(section.entryEventId)) fail(`${sectionPath}.entryEventId`, 'does not resolve');
+      for (let eventIndex = 0; eventIndex < events.length; eventIndex += 1) {
+        const event = events[eventIndex];
+        const eventPath = `${sectionPath}.events[${eventIndex}]`;
+        if (event.nextEventId !== undefined && !eventIds.has(event.nextEventId)) {
+          fail(`${eventPath}.nextEventId`, 'does not resolve inside the section');
+        }
+        for (let choiceIndex = 0; choiceIndex < (event.choices ?? []).length; choiceIndex += 1) {
+          if (!eventIds.has(event.choices[choiceIndex].nextEventId)) {
+            fail(`${eventPath}.choices[${choiceIndex}].nextEventId`, 'does not resolve inside the section');
+          }
+        }
+        for (let cueIndex = 0; cueIndex < (event.cues ?? []).length; cueIndex += 1) {
+          const cue = event.cues[cueIndex];
+          if (cue.stopEventId !== undefined && !eventIds.has(cue.stopEventId)) {
+            fail(`${eventPath}.cues[${cueIndex}].stopEventId`, 'does not resolve inside the section');
+          }
+        }
+      }
+    }
+  }
+  return story;
+}
+
+export function validateCatalog(value) {
+  const catalog = asRecord(value, 'catalog');
+  if (catalog.schema !== CATALOG_SCHEMA) fail('catalog.schema', `must equal ${CATALOG_SCHEMA}`);
+  asSimpleId(catalog.revision, 'catalog.revision');
+  const corpora = asArray(catalog.corpora, 'catalog.corpora', { min: 1, max: 10_000 });
+  assertUnique(corpora.map((corpus) => asRecord(corpus, 'catalog.corpus').corpusId), 'catalog.corpora');
+  const storyIds = [];
+  corpora.forEach((value, corpusIndex) => {
+    const path = `catalog.corpora[${corpusIndex}]`;
+    const corpus = asRecord(value, path);
+    asSimpleId(corpus.corpusId, `${path}.corpusId`);
+    asString(corpus.title, `${path}.title`, { max: 512 });
+    asSimpleId(corpus.adapterId, `${path}.adapterId`);
+    asString(corpus.sourceFormat, `${path}.sourceFormat`, { max: 128 });
+    const features = asArray(corpus.features, `${path}.features`, { max: 128 });
+    features.forEach((feature, index) => asSimpleId(feature, `${path}.features[${index}]`));
+    assertUnique(features, `${path}.features`);
+    const stories = asArray(corpus.stories, `${path}.stories`, { min: 1, max: 1_000_000 });
+    stories.forEach((value, storyIndex) => {
+      const storyPath = `${path}.stories[${storyIndex}]`;
+      const story = asRecord(value, storyPath);
+      storyIds.push(asPathId(story.canonicalStoryId, `${storyPath}.canonicalStoryId`));
+      asString(story.title, `${storyPath}.title`, { max: 512 });
+      asString(story.source, `${storyPath}.source`, { max: 2048 });
+      asString(story.mediaManifest, `${storyPath}.mediaManifest`, { max: 2048 });
+      asPathId(story.preferredVariantId, `${storyPath}.preferredVariantId`);
+    });
+  });
+  assertUnique(storyIds, 'catalog stories');
+  return catalog;
+}
+
+export function validateMediaManifest(value) {
+  const manifest = asRecord(value, 'media');
+  if (manifest.schema !== MEDIA_SCHEMA) fail('media.schema', `must equal ${MEDIA_SCHEMA}`);
+  asSimpleId(manifest.revision, 'media.revision');
+  asSimpleId(manifest.resolverId, 'media.resolverId');
+  const entries = asArray(manifest.entries, 'media.entries', { max: 2_000_000 });
+  entries.forEach((value, index) => {
+    const path = `media.entries[${index}]`;
+    const entry = asRecord(value, path);
+    asPathId(entry.mediaId, `${path}.mediaId`);
+    if (!MEDIA_KINDS.includes(entry.role)) fail(`${path}.role`, 'is not a supported media role');
+    asString(entry.url, `${path}.url`, { max: 4096 });
+    if (entry.mimeType !== undefined) asString(entry.mimeType, `${path}.mimeType`, { max: 256 });
+  });
+  assertUnique(entries.map((entry) => entry.mediaId), 'media.entries');
+  return manifest;
+}
+
+export function localizedText(record, locale, fallbacks = []) {
+  if (!record || typeof record !== 'object') return '';
+  for (const candidate of [locale, ...fallbacks]) {
+    const text = record[candidate];
+    if (typeof text === 'string') return text;
+  }
+  const first = Object.values(record).find((value) => typeof value === 'string');
+  return typeof first === 'string' ? first : '';
+}
+
+export function allStoryEvents(story) {
+  validateStoryDocument(story);
+  return story.variants.flatMap((variant) =>
+    variant.sections.flatMap((section) => section.events),
+  );
+}
diff --git a/packages/core/src/adapter-registry.js b/packages/core/src/adapter-registry.js
new file mode 100644
index 0000000000000000000000000000000000000000..833b539fdbb1f7fc7bdeb568b0344a2afd3b65bd
--- /dev/null
+++ b/packages/core/src/adapter-registry.js
@@ -0,0 +1,86 @@
+import { validateStoryDocument } from '../../contracts/src/index.js';
+
+export class AdapterRegistryError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'AdapterRegistryError';
+  }
+}
+
+const validAdapter = (adapter) =>
+  adapter
+  && typeof adapter === 'object'
+  && typeof adapter.id === 'string'
+  && Array.isArray(adapter.sourceFormats)
+  && adapter.sourceFormats.length > 0
+  && typeof adapter.load === 'function';
+
+export class AdapterRegistry {
+  #adapters = new Map();
+
+  register(adapter) {
+    if (!validAdapter(adapter)) throw new AdapterRegistryError('adapter contract is invalid');
+    if (this.#adapters.has(adapter.id)) {
+      throw new AdapterRegistryError(`adapter ${adapter.id} is already registered`);
+    }
+    this.#adapters.set(adapter.id, Object.freeze({
+      ...adapter,
+      sourceFormats: Object.freeze([...adapter.sourceFormats]),
+    }));
+    return () => this.#adapters.delete(adapter.id);
+  }
+
+  has(adapterId) {
+    return this.#adapters.has(adapterId);
+  }
+
+  get(adapterId) {
+    return this.#adapters.get(adapterId) ?? null;
+  }
+
+  list() {
+    return [...this.#adapters.values()];
+  }
+
+  async loadStory(corpus, storyEntry, io) {
+    if (!corpus || typeof corpus !== 'object') {
+      throw new AdapterRegistryError('corpus record is missing');
+    }
+    const adapter = this.#adapters.get(corpus.adapterId);
+    if (!adapter) {
+      throw new AdapterRegistryError(
+        `declared adapter ${JSON.stringify(corpus.adapterId)} is not installed`,
+      );
+    }
+    if (!adapter.sourceFormats.includes(corpus.sourceFormat)) {
+      throw new AdapterRegistryError(
+        `adapter ${adapter.id} does not accept source format ${JSON.stringify(corpus.sourceFormat)}`,
+      );
+    }
+
+    let story;
+    try {
+      story = await adapter.load({ corpus, storyEntry, io });
+    } catch (error) {
+      const detail = error instanceof Error ? error.message : String(error);
+      throw new AdapterRegistryError(`adapter ${adapter.id} failed: ${detail}`);
+    }
+    validateStoryDocument(story);
+    if (story.adapterId !== adapter.id) {
+      throw new AdapterRegistryError(
+        `loaded story declares ${story.adapterId}, expected exact adapter ${adapter.id}`,
+      );
+    }
+    if (story.corpusId !== corpus.corpusId) {
+      throw new AdapterRegistryError(
+        `loaded story corpus ${story.corpusId} differs from ${corpus.corpusId}`,
+      );
+    }
+    if (story.canonicalStoryId !== storyEntry.canonicalStoryId) {
+      throw new AdapterRegistryError(
+        `loaded story ID ${story.canonicalStoryId} differs from catalog ${storyEntry.canonicalStoryId}`,
+      );
+    }
+    return story;
+  }
+}
diff --git a/packages/core/src/audio-controller.js b/packages/core/src/audio-controller.js
new file mode 100644
index 0000000000000000000000000000000000000000..cbdd502d6a1ed8f69ae28a8158d66df6887d7cc6
--- /dev/null
+++ b/packages/core/src/audio-controller.js
@@ -0,0 +1,135 @@
+const IDLE = Object.freeze({ status: 'idle', cueId: null, error: null });
+
+export class BrowserAudioBackend {
+  #audio;
+  #ended = () => {};
+  #failed = () => {};
+
+  constructor(url) {
+    this.#audio = new Audio(url);
+    this.#audio.preload = 'none';
+    this.#audio.addEventListener('ended', () => this.#ended(), { once: true });
+    this.#audio.addEventListener('error', () => this.#failed(new Error('browser audio failed')), {
+      once: true,
+    });
+  }
+
+  onEnded(callback) {
+    this.#ended = callback;
+  }
+
+  onError(callback) {
+    this.#failed = callback;
+  }
+
+  async play() {
+    await this.#audio.play();
+  }
+
+  stop() {
+    this.#audio.pause();
+    this.#audio.removeAttribute('src');
+    this.#audio.load();
+  }
+}
+
+export class AudioController {
+  #state = IDLE;
+  #listeners = new Set();
+  #backend = null;
+  #backendFactory;
+  #disposed = false;
+
+  constructor({ backendFactory = (url) => new BrowserAudioBackend(url) } = {}) {
+    this.#backendFactory = backendFactory;
+  }
+
+  #setState(next) {
+    this.#state = Object.freeze(next);
+    for (const listener of [...this.#listeners]) listener(this.#state);
+  }
+
+  subscribe(listener) {
+    if (this.#disposed) return () => {};
+    this.#listeners.add(listener);
+    return () => this.#listeners.delete(listener);
+  }
+
+  getSnapshot() {
+    return this.#state;
+  }
+
+  async toggle(cue, resolution) {
+    if (this.#disposed) return;
+    if (this.#state.cueId === cue.cueId && ['loading', 'playing'].includes(this.#state.status)) {
+      this.stop();
+      return;
+    }
+    await this.play(cue, resolution);
+  }
+
+  async play(cue, resolution) {
+    if (this.#disposed) return;
+    this.stop();
+    if (!resolution || resolution.status !== 'resolved') {
+      this.#setState({
+        status: 'error',
+        cueId: cue.cueId,
+        error: resolution?.reason ?? 'media route is unresolved',
+      });
+      return;
+    }
+    const backend = this.#backendFactory(resolution.url, resolution);
+    this.#backend = backend;
+    backend.onEnded?.(() => {
+      if (this.#backend === backend) {
+        this.#backend = null;
+        this.#setState(IDLE);
+      }
+    });
+    backend.onError?.((error) => {
+      if (this.#backend === backend) {
+        this.#backend = null;
+        this.#setState({
+          status: 'error',
+          cueId: cue.cueId,
+          error: error instanceof Error ? error.message : String(error),
+        });
+      }
+    });
+    this.#setState({ status: 'loading', cueId: cue.cueId, error: null });
+    try {
+      await backend.play();
+      if (this.#backend === backend) {
+        this.#setState({ status: 'playing', cueId: cue.cueId, error: null });
+      }
+    } catch (error) {
+      if (this.#backend === backend) {
+        this.#backend = null;
+        backend.stop?.();
+        this.#setState({
+          status: 'error',
+          cueId: cue.cueId,
+          error: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  }
+
+  stop() {
+    this.#backend?.stop?.();
+    this.#backend = null;
+    if (this.#state !== IDLE) this.#setState(IDLE);
+  }
+
+  suspend() {
+    this.stop();
+  }
+
+  dispose() {
+    if (this.#disposed) return;
+    this.stop();
+    this.#disposed = true;
+    this.#listeners.clear();
+  }
+}
diff --git a/packages/core/src/media-resolver-registry.js b/packages/core/src/media-resolver-registry.js
new file mode 100644
index 0000000000000000000000000000000000000000..15077ad734ed5a2fb324ce75b5861c9333eeaea6
--- /dev/null
+++ b/packages/core/src/media-resolver-registry.js
@@ -0,0 +1,105 @@
+import { validateMediaManifest } from '../../contracts/src/index.js';
+
+export class MediaResolverError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'MediaResolverError';
+  }
+}
+
+const unresolved = (cue, reason, resolverId = null) => Object.freeze({
+  status: 'unresolved',
+  cueId: cue.cueId,
+  kind: cue.kind,
+  resolverId,
+  reason,
+});
+
+export class MediaResolverRegistry {
+  #resolvers = new Map();
+
+  register(resolver) {
+    if (
+      !resolver
+      || typeof resolver.id !== 'string'
+      || typeof resolver.resolve !== 'function'
+      || !Array.isArray(resolver.kinds)
+    ) {
+      throw new MediaResolverError('resolver contract is invalid');
+    }
+    if (this.#resolvers.has(resolver.id)) {
+      throw new MediaResolverError(`resolver ${resolver.id} is already registered`);
+    }
+    this.#resolvers.set(resolver.id, Object.freeze({
+      ...resolver,
+      kinds: Object.freeze([...resolver.kinds]),
+    }));
+    return () => this.#resolvers.delete(resolver.id);
+  }
+
+  get(id) {
+    return this.#resolvers.get(id) ?? null;
+  }
+
+  async resolve(cue, context = {}) {
+    if (!cue || typeof cue !== 'object' || typeof cue.cueId !== 'string') {
+      throw new MediaResolverError('cue is invalid');
+    }
+    const resolverId = cue.resolverId ?? context.defaultResolverId;
+    if (!resolverId) return unresolved(cue, 'no resolver was declared');
+    const resolver = this.#resolvers.get(resolverId);
+    if (!resolver) return unresolved(cue, `resolver ${resolverId} is not installed`, resolverId);
+    if (!resolver.kinds.includes(cue.kind)) {
+      return unresolved(cue, `resolver ${resolverId} does not support ${cue.kind}`, resolverId);
+    }
+    if (!cue.mediaId) return unresolved(cue, 'cue has no mediaId', resolverId);
+    try {
+      const result = await resolver.resolve(cue, context);
+      if (!result) return unresolved(cue, 'mediaId was not found', resolverId);
+      return Object.freeze({
+        status: 'resolved',
+        cueId: cue.cueId,
+        kind: cue.kind,
+        resolverId,
+        mediaId: cue.mediaId,
+        url: result.url,
+        mimeType: result.mimeType ?? null,
+        metadata: Object.freeze({ ...(result.metadata ?? {}) }),
+      });
+    } catch (error) {
+      const detail = error instanceof Error ? error.message : String(error);
+      return unresolved(cue, detail, resolverId);
+    }
+  }
+}
+
+const safeResolvedUrl = (value, baseUrl) => {
+  const url = new URL(value, baseUrl);
+  if (!['http:', 'https:'].includes(url.protocol)) {
+    throw new MediaResolverError(`unsupported media URL protocol ${url.protocol}`);
+  }
+  return url.href;
+};
+
+export function createManifestMediaResolver(manifest, { baseUrl }) {
+  validateMediaManifest(manifest);
+  const entries = new Map(manifest.entries.map((entry) => [entry.mediaId, entry]));
+  return {
+    id: manifest.resolverId,
+    kinds: ['voice', 'bgm', 'sfx', 'image', 'video'],
+    async resolve(cue) {
+      const entry = entries.get(cue.mediaId);
+      if (!entry) return null;
+      if (entry.role !== cue.kind) {
+        throw new MediaResolverError(
+          `media ${entry.mediaId} is ${entry.role}, not requested ${cue.kind}`,
+        );
+      }
+      return {
+        url: safeResolvedUrl(entry.url, baseUrl),
+        mimeType: entry.mimeType,
+        metadata: { role: entry.role, revision: manifest.revision },
+      };
+    },
+  };
+}
diff --git a/packages/core/src/preferences.js b/packages/core/src/preferences.js
new file mode 100644
index 0000000000000000000000000000000000000000..b76dbf2c0ec4c996d0b469400959ff3c59b716fe
--- /dev/null
+++ b/packages/core/src/preferences.js
@@ -0,0 +1,59 @@
+export const PREFERENCES_KEY = 'universal-adv-reader:preferences:v1';
+
+export const DEFAULT_READER_PREFERENCES = Object.freeze({
+  localeMode: 'parallel',
+  primaryLocale: 'zh-CN',
+  secondaryLocale: 'ja-JP',
+  voicePanelExpanded: false,
+  voiceSlotMode: 'all',
+});
+
+const localeModes = new Set(['primary', 'parallel']);
+const voiceSlotModes = new Set(['all', 'declared']);
+const locale = (value, fallback) =>
+  typeof value === 'string' && /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/u.test(value)
+    ? value
+    : fallback;
+
+export function parseReaderPreferences(value) {
+  let input = value;
+  if (typeof input === 'string') {
+    try {
+      input = JSON.parse(input);
+    } catch {
+      input = null;
+    }
+  }
+  if (!input || typeof input !== 'object' || Array.isArray(input)) {
+    return { ...DEFAULT_READER_PREFERENCES };
+  }
+  return {
+    localeMode: localeModes.has(input.localeMode)
+      ? input.localeMode
+      : DEFAULT_READER_PREFERENCES.localeMode,
+    primaryLocale: locale(input.primaryLocale, DEFAULT_READER_PREFERENCES.primaryLocale),
+    secondaryLocale: locale(input.secondaryLocale, DEFAULT_READER_PREFERENCES.secondaryLocale),
+    voicePanelExpanded: input.voicePanelExpanded === true,
+    voiceSlotMode: voiceSlotModes.has(input.voiceSlotMode)
+      ? input.voiceSlotMode
+      : DEFAULT_READER_PREFERENCES.voiceSlotMode,
+  };
+}
+
+export function loadReaderPreferences(storage = globalThis.localStorage) {
+  try {
+    return parseReaderPreferences(storage?.getItem(PREFERENCES_KEY));
+  } catch {
+    return { ...DEFAULT_READER_PREFERENCES };
+  }
+}
+
+export function saveReaderPreferences(preferences, storage = globalThis.localStorage) {
+  const normalized = parseReaderPreferences(preferences);
+  try {
+    storage?.setItem(PREFERENCES_KEY, JSON.stringify(normalized));
+  } catch {
+    // Volatile state remains usable when storage is blocked.
+  }
+  return normalized;
+}
diff --git a/packages/core/src/reader-session.js b/packages/core/src/reader-session.js
new file mode 100644
index 0000000000000000000000000000000000000000..99205829c0b634f5ca6275d6e94aa444c417f07b
--- /dev/null
+++ b/packages/core/src/reader-session.js
@@ -0,0 +1,233 @@
+import { validateStoryDocument } from '../../contracts/src/index.js';
+
+export class ReaderRouteError extends Error {
+  constructor(message) {
+    super(message);
+    this.name = 'ReaderRouteError';
+  }
+}
+
+const pickVariant = (story, variantId) => {
+  const variant = variantId
+    ? story.variants.find((item) => item.variantId === variantId)
+    : story.variants[0];
+  if (!variant) throw new ReaderRouteError(`variant ${JSON.stringify(variantId)} does not exist`);
+  return variant;
+};
+
+const pickSection = (variant, sectionId) => {
+  const section = sectionId
+    ? variant.sections.find((item) => item.sectionId === sectionId)
+    : variant.sections[0];
+  if (!section) throw new ReaderRouteError(`section ${JSON.stringify(sectionId)} does not exist`);
+  return section;
+};
+
+export class ReaderSession {
+  #story;
+  #variant;
+  #section;
+  #eventMap;
+  #currentEventId;
+  #history;
+  #listeners = new Set();
+  #suspended = false;
+  #disposed = false;
+
+  constructor(story, location = {}) {
+    this.#story = validateStoryDocument(story);
+    this.#variant = pickVariant(story, location.variantId);
+    this.#section = pickSection(this.#variant, location.sectionId);
+    this.#eventMap = new Map(this.#section.events.map((event) => [event.eventId, event]));
+    this.#assertStoryLocation(location);
+    this.#currentEventId = location.eventId ?? this.#section.entryEventId;
+    if (!this.#eventMap.has(this.#currentEventId)) {
+      throw new ReaderRouteError(`event ${JSON.stringify(this.#currentEventId)} does not exist`);
+    }
+    this.#history = [this.#currentEventId];
+  }
+
+  #assertLive() {
+    if (this.#disposed) throw new ReaderRouteError('reader session is disposed');
+  }
+
+  #assertStoryLocation(location) {
+    if (
+      location.canonicalStoryId !== undefined
+      && location.canonicalStoryId !== this.#story.canonicalStoryId
+    ) {
+      throw new ReaderRouteError('location belongs to a different story');
+    }
+  }
+
+  #replaceSection(variant, section, eventId) {
+    this.#variant = variant;
+    this.#section = section;
+    this.#eventMap = new Map(section.events.map((event) => [event.eventId, event]));
+    const target = eventId ?? section.entryEventId;
+    if (!this.#eventMap.has(target)) {
+      throw new ReaderRouteError(`event ${JSON.stringify(target)} does not exist`);
+    }
+    this.#currentEventId = target;
+    this.#history = [target];
+  }
+
+  #emit() {
+    const snapshot = this.snapshot();
+    for (const listener of [...this.#listeners]) listener(snapshot);
+  }
+
+  subscribe(listener) {
+    this.#assertLive();
+    if (typeof listener !== 'function') throw new TypeError('listener must be a function');
+    this.#listeners.add(listener);
+    return () => this.#listeners.delete(listener);
+  }
+
+  open(location) {
+    this.#assertLive();
+    this.#assertStoryLocation(location);
+    const variant = pickVariant(this.#story, location.variantId ?? this.#variant.variantId);
+    const section = pickSection(variant, location.sectionId ?? this.#section.sectionId);
+    this.#replaceSection(variant, section, location.eventId);
+    this.#emit();
+    return this.snapshot();
+  }
+
+  goTo(eventId, { replace = false } = {}) {
+    this.#assertLive();
+    if (!this.#eventMap.has(eventId)) {
+      throw new ReaderRouteError(`event ${JSON.stringify(eventId)} does not exist`);
+    }
+    this.#currentEventId = eventId;
+    if (replace) this.#history[this.#history.length - 1] = eventId;
+    else this.#history.push(eventId);
+    this.#emit();
+    return this.snapshot();
+  }
+
+  next() {
+    this.#assertLive();
+    const event = this.currentEvent;
+    if (event.kind === 'choice') {
+      throw new ReaderRouteError('choice event requires an explicit choiceId');
+    }
+    if (!event.nextEventId) return false;
+    this.goTo(event.nextEventId);
+    return true;
+  }
+
+  choose(choiceId) {
+    this.#assertLive();
+    const event = this.currentEvent;
+    if (event.kind !== 'choice') throw new ReaderRouteError('current event is not a choice');
+    const choice = event.choices.find((item) => item.choiceId === choiceId);
+    if (!choice) throw new ReaderRouteError(`choice ${JSON.stringify(choiceId)} does not exist`);
+    this.goTo(choice.nextEventId);
+    return choice;
+  }
+
+  back() {
+    this.#assertLive();
+    if (this.#history.length <= 1) return false;
+    this.#history.pop();
+    this.#currentEventId = this.#history[this.#history.length - 1];
+    this.#emit();
+    return true;
+  }
+
+  suspend() {
+    this.#assertLive();
+    this.#suspended = true;
+    this.#emit();
+  }
+
+  resume() {
+    this.#assertLive();
+    this.#suspended = false;
+    this.#emit();
+  }
+
+  dispose() {
+    if (this.#disposed) return;
+    this.#disposed = true;
+    this.#listeners.clear();
+  }
+
+  get currentEvent() {
+    return this.#eventMap.get(this.#currentEventId);
+  }
+
+  get events() {
+    return this.#section.events;
+  }
+
+  get variant() {
+    return this.#variant;
+  }
+
+  get section() {
+    return this.#section;
+  }
+
+  get story() {
+    return this.#story;
+  }
+
+  get history() {
+    return [...this.#history];
+  }
+
+  get location() {
+    return {
+      canonicalStoryId: this.#story.canonicalStoryId,
+      variantId: this.#variant.variantId,
+      sectionId: this.#section.sectionId,
+      eventId: this.#currentEventId,
+      storyRevision: this.#story.revision,
+    };
+  }
+
+  snapshot() {
+    const ordinal = this.#section.events.findIndex((event) => event.eventId === this.#currentEventId);
+    return Object.freeze({
+      location: Object.freeze(this.location),
+      currentEvent: this.currentEvent,
+      ordinal,
+      total: this.#section.events.length,
+      history: Object.freeze([...this.#history]),
+      suspended: this.#suspended,
+      disposed: this.#disposed,
+    });
+  }
+}
+
+export function voiceRouteSummary(story) {
+  validateStoryDocument(story);
+  let eligibleEvents = 0;
+  let cueEvents = 0;
+  let voiceCues = 0;
+  for (const variant of story.variants) {
+    for (const section of variant.sections) {
+      for (const event of section.events) {
+        if (event.kind !== 'line') continue;
+        eligibleEvents += 1;
+        const cues = (event.cues ?? []).filter((cue) => cue.kind === 'voice');
+        if (cues.length > 0) cueEvents += 1;
+        voiceCues += cues.length;
+      }
+    }
+  }
+  return { eligibleEvents, cueEvents, voiceCues, expandableForAllStories: true };
+}
+
+export function voiceSlotForEvent(event) {
+  if (!event || event.kind !== 'line') return null;
+  const cues = (event.cues ?? []).filter((cue) => cue.kind === 'voice');
+  return Object.freeze({
+    eventId: event.eventId,
+    cues: Object.freeze([...cues]),
+    status: cues.length > 0 ? 'declared' : 'empty',
+    visibleWhenExpanded: true,
+  });
+}
