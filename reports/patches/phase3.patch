+            timing: route.kind === 'image' || route.kind === 'bgm' ? 'scene' : 'utterance',
+            mediaId: route.mediaId,
+            resolverId: RESOLVER_ID,
+            raw: {
+              sourceKey: route.key,
+              codeOffset: operand.codeOffset,
