+  const score = (value) => {
+    if (value.includes('/data1.arc.unpacked/')) return 0;
+    if (value.includes('/fastdata.arc.unpacked/')) return 1;
+    if (value.includes('/update.arc.unpacked/')) return 2;
+    return 3;
+  };
+  return score(left) - score(right) || left.localeCompare(right);
