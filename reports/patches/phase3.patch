+                ? { presentationRole: isTransitionImageKey(route.key) ? 'transition' : 'scene' }
+                : {}),
+              ...(route.candidates?.length > 1
+                ? { losslessCandidates: route.candidates, selectedLayer: 'base-scenario' }
