+      engine: 'majiro',
+      sourceSchema: 'vn-mjo-reader-script/v1',
+      sourceRepository: 'narcissu-kana-research',
+      sourceManifest: READER_MANIFEST,
+      sourceBridgeRevision: readerManifest.bridgeRevision,
