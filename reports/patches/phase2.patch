+  const story = validateStoryDocument({
+    schema: 'adv-story/v1',
+    corpusId: 'narcissu10',
+    canonicalStoryId: options.storyId,
+    adapterId: MAJIRO_PRODUCTION_ADAPTER_ID,
+    revision: `himeko-ep00-${readerManifest.bridgeRevision}`,
+    title: 'Narcissu 10th · Himeko EP00',
